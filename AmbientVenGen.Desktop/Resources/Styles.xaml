<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Application-wide styles. Implicit styles MUST be based on the WPF-UI ones. Without BasedOn the
        style replaces the WPF-UI control template with the default system one
        (white popup + light text in the dark theme).
    -->

    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
        <Setter Property="Margin" Value="0,1,0,2" />
        <Setter Property="Height" Value="22" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!--  ComboBox over a list of vm:Choice items (label + value).  -->
    <Style
        x:Key="ChoiceCombo"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <!--  Translucent card: the window backdrop shines through.  -->
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="#8C20202B" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  24x24 icon-only button for the tool panels.  -->
    <Style
        x:Key="ToolIconButton"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  30x30 icon button (25% larger) for the Play / Seed buttons in the Timeline section.  -->
    <Style
        x:Key="TimelineIconButton"
        BasedOn="{StaticResource ToolIconButton}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!--  24x24 icon-only toggle button for the tool panels. Checked = accent background.  -->
    <Style
        x:Key="ToolIconToggleButton"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Square toggle button with an icon (mute). Checked = accent background.  -->
    <Style
        x:Key="MuteToggleButton"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Mute / unmute layer" />
    </Style>

    <!-- Caption close button: fully opaque, so it is always hit-testable (see WindowCloseButton). -->
    <Style TargetType="controls:WindowCloseButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WindowCloseButton">
                    <Border x:Name="Back" Background="#FF2A2A38">
                        <Path
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L10,10 M10,0 L0,10"
                            Stroke="#ECECF2"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.2" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#FFC42B1C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#FF9E2216" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
