<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Application-wide styles. Implicit styles MUST be based on the WPF-UI ones. Without BasedOn the
        style replaces the WPF-UI control template with the default system one
        (white popup + light text in the dark theme).
    -->

    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
        <Setter Property="Margin" Value="0,1,0,2" />
        <Setter Property="Height" Value="22" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!--  ComboBox over a list of vm:Choice items (label + value).  -->
    <Style
        x:Key="ChoiceCombo"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <!--  Translucent card: the window backdrop shines through.  -->
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="#8C20202B" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  24x24 icon-only button for the tool panels.  -->
    <Style
        x:Key="ToolIconButton"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  29x29 icon buttons (20% larger) of the top tool panel.  -->
    <Style
        x:Key="TopToolButton"
        BasedOn="{StaticResource ToolIconButton}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="29" />
        <Setter Property="MinWidth" Value="29" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!--  30x30 icon button (25% larger) for the Play / Seed buttons in the Timeline section.  -->
    <Style
        x:Key="TimelineIconButton"
        BasedOn="{StaticResource ToolIconButton}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!--  24x24 icon-only toggle button for the tool panels. Checked = accent background.  -->
    <Style
        x:Key="ToolIconToggleButton"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Toggle button of the top tool panel (20% larger).  -->
    <Style
        x:Key="TopToolToggleButton"
        BasedOn="{StaticResource ToolIconToggleButton}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="29" />
        <Setter Property="MinWidth" Value="29" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!--  Square toggle button with an icon (mute). Checked = accent background.  -->
    <Style
        x:Key="MuteToggleButton"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Mute / unmute layer" />
    </Style>

    <!--  Caption close button: fully opaque, so it is always hit-testable (see WindowCloseButton).  -->
    <Style TargetType="controls:WindowCaptionButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="33" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WindowCaptionButton">
                    <Border x:Name="Back" Background="#FF2A2A38">
                        <Path
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Glyph}"
                            Stroke="#ECECF2"
                            StrokeThickness="1.2" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsClose" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Back" Property="Background" Value="#FFC42B1C" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Side tabs (Oscillators / Events): two equal flat tabs on one line, the picked one tinted with an accent line  -->
    <Style x:Key="SideTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="#9A99AA" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Frame"
                        Height="30"
                        Margin="0,0,4,0"
                        Padding="14,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2"
                        CornerRadius="5,5,0,0">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            TextElement.FontSize="13"
                            TextElement.FontWeight="SemiBold"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="#E6E6F2" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#26B7AFE9" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#B7AFE9" />
                            <Setter Property="Foreground" Value="#F2F1FA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SideTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Margin="6,0,0,0"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <TabPanel
                                    Margin="0"
                                    Panel.ZIndex="1"
                                    DockPanel.Dock="Left"
                                    IsItemsHost="True" />
                                <ToggleButton
                                    Margin="4,0,0,2"
                                    DockPanel.Dock="Left"
                                    IsChecked="{Binding DataContext.Settings.RightPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    Style="{StaticResource CollapseArrowRight}"
                                    ToolTip="Hide this group" />
                            </DockPanel>
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="0,6,0,0" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Narrow vertical bar that folds a side group of the main window (the caption is turned sideways)  -->
    <Style x:Key="SideToggleLeft" TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Frame"
                        Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Margin="0,8" HorizontalAlignment="Center">
                            <ui:SymbolIcon
                                x:Name="Chevron"
                                Margin="0,0,0,8"
                                FontSize="14"
                                Foreground="#C9C8D6"
                                Symbol="ChevronLeft24" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#9A99AA"
                                Text="{TemplateBinding Content}">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="270" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight24" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#B7AFE9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Narrow vertical bar that folds a side group of the main window (the caption is turned sideways)  -->
    <Style x:Key="SideToggleRight" TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Frame"
                        Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Margin="0,8" HorizontalAlignment="Center">
                            <ui:SymbolIcon
                                x:Name="Chevron"
                                Margin="0,0,0,8"
                                FontSize="14"
                                Foreground="#C9C8D6"
                                Symbol="ChevronRight24" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#9A99AA"
                                Text="{TemplateBinding Content}">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="270" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronLeft24" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#B7AFE9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Small arrow after the title of a side group: folds the group (a bar to open it again stays at the window edge)  -->
    <Style x:Key="CollapseArrowLeft" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Frame"
                        Background="Transparent"
                        CornerRadius="5">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="#9A99AA"
                            Symbol="ChevronLeft24" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Small arrow after the title of a side group: folds the group (a bar to open it again stays at the window edge)  -->
    <Style x:Key="CollapseArrowRight" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Frame"
                        Background="Transparent"
                        CornerRadius="5">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="#9A99AA"
                            Symbol="ChevronRight24" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
