<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Application-wide styles. Implicit styles MUST be based on the WPF-UI ones. Without BasedOn the
        style replaces the WPF-UI control template with the default system one
        (white popup + light text in the dark theme).
    -->

    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
        <Setter Property="Margin" Value="0,1,0,2" />
        <Setter Property="Height" Value="22" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!--  ComboBox over a list of vm:Choice items (label + value).  -->
    <Style
        x:Key="ChoiceCombo"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <!--  Translucent card: the window backdrop shines through.  -->
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="#8C20202B" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  24x24 icon-only button for the tool panels.  -->
    <Style
        x:Key="ToolIconButton"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="ui:Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
