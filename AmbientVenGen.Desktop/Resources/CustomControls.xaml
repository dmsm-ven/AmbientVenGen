<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls">

    <!--  Look of custom controls (templates). Generic styles live in Styles.xaml.  -->

    <Style TargetType="{x:Type controls:Knob}">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="85" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Knob}">
                    <!--  The root panel is named so that the indicator (a Freezable) can reach the Knob through it.  -->
                    <StackPanel
                        x:Name="RootPanel"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        Orientation="Vertical">

                        <!--  Potentiometer graphics  -->
                        <Grid
                            Width="55"
                            Height="55"
                            HorizontalAlignment="Center">
                            <Ellipse
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="#2D2D2D"
                                Stroke="#3F3F46"
                                StrokeThickness="2" />

                            <!--  Indicator line  -->
                            <Canvas
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Line
                                    Stroke="#007ACC"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="3"
                                    X1="25"
                                    X2="25"
                                    Y1="25"
                                    Y2="10">
                                    <Line.RenderTransform>
                                        <RotateTransform Angle="{Binding TemplatedParent.Angle, ElementName=RootPanel}" CenterX="25" CenterY="25" />
                                    </Line.RenderTransform>
                                </Line>
                            </Canvas>
                        </Grid>

                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="White"
                            Text="{TemplateBinding DisplayText}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
