<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.IconDropdown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AmbientVenGen.Desktop.Controls"
    x:Name="Root"
    Width="32"
    Height="32">
    <UserControl.Resources>
        <ControlTemplate x:Key="TileTemplate" TargetType="ToggleButton">
            <Border
                x:Name="Frame"
                Background="#1AFFFFFF"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#88B7AFE9" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#B7AFE9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="TileStyle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource TileTemplate}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, ElementName=Pop}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Row"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3DB7AFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton
            x:Name="Field"
            IsChecked="{Binding IsOpen, ElementName=Pop, Mode=TwoWay}"
            Style="{StaticResource TileStyle}">
            <local:ModGlyph
                Width="20"
                Height="20"
                Key="{Binding Value, ElementName=Root}" />
        </ToggleButton>

        <Popup
            x:Name="Pop"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=Field}"
            StaysOpen="False"
            VerticalOffset="4">
            <Border
                Padding="6"
                Background="#F2181821"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ItemStyle}"
                    ItemsSource="{Binding ItemsSource, ElementName=Root}"
                    SelectedValue="{Binding Value, ElementName=Root, Mode=TwoWay}"
                    SelectedValuePath="Value"
                    SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:ModGlyph
                                    Width="20"
                                    Height="20"
                                    Key="{Binding Value}" />
                                <TextBlock
                                    MinWidth="90"
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="#F2F2F8"
                                    Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
