<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.ModulatorEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    x:Name="Root">
    <!--  DataContext: a Modulator (shape, rate, depth, target)  -->
    <UserControl.Resources>
        <ControlTemplate x:Key="MuteTemplate" TargetType="ToggleButton">
            <Border
                x:Name="Frame"
                Background="#1AFFFFFF"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="6">
                <controls:ModGlyph
                    x:Name="Icon"
                    Width="20"
                    Height="20"
                    Key="Mute" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33E5737F" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#AAE5737F" />
                    <Setter TargetName="Icon" Property="Stroke" Value="#F08A94" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <!--  DataContext: a Modulator. The group is kept close to the background colour.  -->
    <Border
        Padding="6,4"
        Background="#0DFFFFFF"
        BorderBrush="#1FFFFFFF"
        BorderThickness="1"
        CornerRadius="5">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Title}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C9C8D6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Foreground" Value="#77808090" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Modulator}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                    </StackPanel.LayoutTransform>
                    <controls:IconDropdown
                        ItemsSource="{x:Static vm:Choices.ModTargets}"
                        ToolTip="What the modulator moves"
                        Value="{Binding Target, Mode=TwoWay}" />
                    <controls:IconDropdown
                        Margin="6,0,0,0"
                        ItemsSource="{x:Static vm:Choices.ModShapes}"
                        ToolTip="How it moves: sine, triangle or smooth random"
                        Value="{Binding Shape, Mode=TwoWay}" />
                    <ToggleButton
                        Width="32"
                        Height="32"
                        Margin="6,0,0,0"
                        Cursor="Hand"
                        IsChecked="{Binding Muted, Mode=TwoWay}"
                        Template="{StaticResource MuteTemplate}"
                        ToolTip="Mute: switch this modulator off" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        Click="OnRemoveClick"
                        Cursor="Hand"
                        ToolTip="Remove this modulator">
                        <ui:SymbolIcon FontSize="16" Symbol="Dismiss24" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <controls:LabeledSlider
                    Margin="4,0"
                    Format="{}{0:0.000} Hz"
                    Header="Rate"
                    Hint="{x:Static vm:HintTexts.ModRate}"
                    IsLogarithmic="True"
                    Maximum="2"
                    Minimum="0.005"
                    Step="0.001"
                    Value="{Binding RateHz, Mode=TwoWay}" />
                <controls:LabeledSlider
                    Margin="4,0"
                    Format="{}{0:P0}"
                    Header="Depth"
                    Hint="{x:Static vm:HintTexts.ModDepth}"
                    Maximum="1"
                    Minimum="0"
                    Step="0.01"
                    Value="{Binding Depth, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
