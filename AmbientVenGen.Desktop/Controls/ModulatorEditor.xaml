<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.ModulatorEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    x:Name="Root">
    <!--  DataContext: a Modulator (shape, rate, depth, target)  -->
    <Border
        Padding="12,8"
        Background="#26FFFFFF"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel>
            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#C9C8D6"
                    Text="{Binding Header, ElementName=Root}" />
                <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Modulator}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <ComboBox
                    Width="120"
                    ItemsSource="{x:Static vm:Choices.ModTargets}"
                    SelectedValue="{Binding Target, Mode=TwoWay}"
                    Style="{StaticResource ChoiceCombo}"
                    ToolTip="What the modulator moves" />
                <ComboBox
                    Width="100"
                    Margin="6,0,0,0"
                    ItemsSource="{x:Static vm:Choices.ModShapes}"
                    SelectedValue="{Binding Shape, Mode=TwoWay}"
                    Style="{StaticResource ChoiceCombo}"
                    ToolTip="How it moves: sine, triangle or smooth random" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Target}" Value="None">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <controls:LabeledSlider
                    Margin="6,0"
                    Format="{}{0:0.000} Hz"
                    Header="Rate"
                    Hint="{x:Static vm:HintTexts.ModRate}"
                    IsLogarithmic="True"
                    Maximum="2"
                    Minimum="0.005"
                    Step="0.001"
                    Value="{Binding RateHz, Mode=TwoWay}" />
                <controls:LabeledSlider
                    Margin="6,0"
                    Format="{}{0:P0}"
                    Header="Depth"
                    Hint="{x:Static vm:HintTexts.ModDepth}"
                    Maximum="1"
                    Minimum="0"
                    Step="0.01"
                    Value="{Binding Depth, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
