<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.EventEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  DataContext: a LayerEvent (type, start, settings). The selected one has a bright frame.  -->
    <UserControl.Resources>
        <ControlTemplate x:Key="MuteTemplate" TargetType="ToggleButton">
            <Border
                x:Name="Frame"
                Background="#1AFFFFFF"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="6">
                <controls:ModGlyph
                    x:Name="Icon"
                    Width="20"
                    Height="20"
                    Key="Mute" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33E5737F" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#AAE5737F" />
                    <Setter TargetName="Icon" Property="Stroke" Value="#F08A94" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <Border
        Padding="6,4"
        Background="#0DFFFFFF"
        CornerRadius="5"
        Focusable="True"
        PreviewMouseLeftButtonDown="OnPickEvent">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <controls:ModGlyph
                        Width="20"
                        Height="20"
                        Margin="0,0,6,0"
                        Key="{Binding Type}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#C9C8D6"
                        Text="{Binding Title}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                    </StackPanel.LayoutTransform>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Padding="0"
                        Click="OnExpandClick"
                        Cursor="Hand"
                        ToolTip="Fold / unfold the settings of this event">
                        <ui:SymbolIcon FontSize="16">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ChevronUp24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Symbol" Value="ChevronDown24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Padding="0"
                        Click="OnGoToClick"
                        Cursor="Hand"
                        ToolTip="Go to this moment on the timeline (Space)">
                        <ui:SymbolIcon FontSize="16" Symbol="ArrowRight24" />
                    </Button>
                    <ToggleButton
                        Width="32"
                        Height="32"
                        Cursor="Hand"
                        IsChecked="{Binding Muted, Mode=TwoWay}"
                        Template="{StaticResource MuteTemplate}"
                        ToolTip="Mute: switch this event off" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        Click="OnRemoveClick"
                        Cursor="Hand"
                        ToolTip="Remove this event">
                        <ui:SymbolIcon FontSize="16" Symbol="Dismiss24" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <controls:NumberBox
                    Margin="4,1" IsInline="True" Decimals="2" Unit="s"
                    Header="Start"
                    Hint="{x:Static vm:HintTexts.EventStart}"
                    Maximum="{Binding DataContext.SelectedLayer.DurationSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Minimum="0"
                    Step="0.05"
                    Value="{Binding StartSeconds, Mode=TwoWay}" />

                <!--  Echo throw  -->
                <StackPanel Visibility="{Binding IsEcho, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Decimals="2" Unit="s"
                        Header="Hold"
                        Hint="{x:Static vm:HintTexts.EchoThrow}"
                        Maximum="4"
                        Minimum="0.05"
                        Step="0.05"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Decimals="2" Unit="s"
                        Header="Delay time"
                        Maximum="1.5"
                        Minimum="0.05"
                        Step="0.01"
                        Value="{Binding Time, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Scale="100" Unit="%" Decimals="0"
                        Header="Feedback"
                        Maximum="0.92"
                        Minimum="0"
                        Step="0.01"
                        Value="{Binding Amount, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Decimals="1" Unit="s"
                        Header="Silence after"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Value="{Binding Tail, Mode=TwoWay}" />
                </StackPanel>

                <!--  Stutter  -->
                <StackPanel Visibility="{Binding IsStutter, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Decimals="3" Unit="s"
                        Header="Slice"
                        Hint="{x:Static vm:HintTexts.Stutter}"
                        Maximum="1"
                        Minimum="0.02"
                        Step="0.005"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Decimals="0"
                        Header="Repeats"
                        Maximum="32"
                        Minimum="2"
                        Step="1"
                        Value="{Binding Count, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True" Scale="100" Unit="%" Decimals="0"
                        Header="Fade per repeat"
                        Maximum="0.9"
                        Minimum="0"
                        Step="0.01"
                        Value="{Binding Amount, Mode=TwoWay}" />
                </StackPanel>

                <!--  Freeze  -->
                <StackPanel Visibility="{Binding IsFreeze, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Hold"
                        Hint="{x:Static vm:HintTexts.Freeze}"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0.1"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="2"
                        Header="Slice"
                        IsInline="True"
                        Maximum="1"
                        Minimum="0.1"
                        Step="0.05"
                        Unit="s"
                        Value="{Binding Time, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="0"
                        Header="Amount"
                        IsInline="True"
                        Maximum="1"
                        Minimum="0"
                        Scale="100"
                        Step="0.05"
                        Unit="%"
                        Value="{Binding Amount, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Release"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Tail, Mode=TwoWay}" />
                </StackPanel>

                <!--  Pitch dive  -->
                <StackPanel Visibility="{Binding IsDive, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Dive time"
                        Hint="{x:Static vm:HintTexts.PitchDive}"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0.1"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="0"
                        Header="Depth"
                        IsInline="True"
                        Maximum="1"
                        Minimum="0"
                        Scale="24"
                        Step="0.0416667"
                        Unit="st"
                        Value="{Binding Amount, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Recovery"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Tail, Mode=TwoWay}" />
                </StackPanel>

                <!--  Swell / Duck  -->
                <StackPanel Visibility="{Binding IsSwellDuck, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Fade"
                        Hint="{x:Static vm:HintTexts.SwellDuck}"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0.05"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Hold"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Time, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="0"
                        Header="Level"
                        IsInline="True"
                        Maximum="1"
                        Minimum="-1"
                        Scale="100"
                        Step="0.05"
                        Unit="%"
                        Value="{Binding Amount, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1"
                        Decimals="1"
                        Header="Return"
                        IsInline="True"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Tail, Mode=TwoWay}" />
                </StackPanel>

                <!--  Filter sweep  -->
                <StackPanel Visibility="{Binding IsSweep, Converter={StaticResource BoolToVisibility}}">
                    <controls:NumberBox
                        Margin="4,1" IsInline="True"
                        Decimals="1"
                        Header="Sweep time"
                        Hint="{x:Static vm:HintTexts.FilterSweep}"
                        Maximum="20"
                        Minimum="0.05"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Length, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True"
                        Decimals="0"
                        Header="Depth"
                        Maximum="1"
                        Minimum="0"
                        Scale="100"
                        Step="0.05"
                        Unit="%"
                        Value="{Binding Amount, Mode=TwoWay}" />
                    <controls:NumberBox
                        Margin="4,1" IsInline="True"
                        Decimals="1"
                        Header="Recovery"
                        Maximum="20"
                        Minimum="0"
                        Step="0.1"
                        Unit="s"
                        Value="{Binding Tail, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
