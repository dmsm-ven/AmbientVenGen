<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.LabeledSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="HeaderText"
                Margin="0"
                FontSize="12"
                Foreground="#C9C8D6" />
            <TextBlock
                x:Name="ValueText"
                Grid.Column="1"
                Margin="0"
                FontSize="12"
                Foreground="#B7AFE9" />
        </Grid>
        <Slider x:Name="InnerSlider" ValueChanged="OnInnerValueChanged" />
    </StackPanel>
</UserControl>
