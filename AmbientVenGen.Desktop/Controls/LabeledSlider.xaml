<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.LabeledSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Name="HeaderText"
                    Margin="0"
                    FontSize="12"
                    Foreground="#C9C8D6" />
                <local:HintIcon
                    x:Name="HeaderHint"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="ValueText"
                Grid.Column="1"
                Margin="0"
                FontSize="12"
                Foreground="#B7AFE9"
                MouseLeftButtonUp="OnValueTextClick" />
            <TextBox
                x:Name="ValueEditor"
                Grid.Column="1"
                Width="76"
                Height="22"
                MinHeight="0"
                Margin="0,-3"
                Padding="4,0"
                VerticalContentAlignment="Center"
                FontSize="12"
                KeyDown="OnEditorKeyDown"
                LostKeyboardFocus="OnEditorLostFocus"
                TextAlignment="Right"
                Visibility="Collapsed" />
        </Grid>
        <Slider x:Name="InnerSlider" ValueChanged="OnInnerValueChanged" />
    </StackPanel>
</UserControl>
