<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.LabeledSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <StackPanel>
        <Grid x:Name="HeaderGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderPanel" Orientation="Horizontal">
                <TextBlock
                    x:Name="HeaderText"
                    Margin="0"
                    FontSize="12"
                    Foreground="#C9C8D6" />
                <local:HintIcon
                    x:Name="HeaderHint"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="ValueText"
                Grid.Column="1"
                Margin="0"
                FontSize="12"
                Foreground="#B7AFE9"
                MouseLeftButtonUp="OnValueTextClick" />

        </Grid>
        <Slider x:Name="InnerSlider" ValueChanged="OnInnerValueChanged" />
        <local:Knob
            x:Name="InnerKnob"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            Visibility="Collapsed" />
    </StackPanel>
        <!-- The exact-value editor floats over the control: showing it must not change the layout (the window would jump). -->
        <TextBox
                x:Name="ValueEditor"
                Width="76"
                Height="22"
                MinHeight="0"
                Margin="0,-3,0,0"
                Padding="4,0"
                VerticalAlignment="Top"
                VerticalContentAlignment="Center"
                FontSize="12"
                KeyDown="OnEditorKeyDown"
                LostKeyboardFocus="OnEditorLostFocus"
                TextAlignment="Right"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
