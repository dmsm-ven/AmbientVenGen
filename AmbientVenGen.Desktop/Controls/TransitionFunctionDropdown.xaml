<UserControl
    x:Class="AmbientVenGen.Desktop.Controls.TransitionFunctionDropdown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    x:Name="Root"
    Width="64"
    Height="36"
    HorizontalAlignment="Left">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  The closed field: just the curve; hover / open adds the name. Not a WPF-UI style on purpose.  -->
        <ControlTemplate x:Key="FieldTemplate" TargetType="ToggleButton">
            <Border
                x:Name="Frame"
                Background="#22FFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="6">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#88B7AFE9" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="#B7AFE9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FieldStyle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Style.Triggers>
                <!--  While the popup is open a click on the field must not re-open it right after it closed.  -->
                <DataTrigger Binding="{Binding IsOpen, ElementName=Pop}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBadgeStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen, ElementName=Pop}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Row"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3DB7AFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton
            x:Name="Field"
            IsChecked="{Binding IsOpen, ElementName=Pop, Mode=TwoWay}"
            Style="{StaticResource FieldStyle}">
            <Grid Margin="2">
                <local:EasingCurveIcon x:Name="FieldIcon" />
                <Border
                    Margin="3"
                    Padding="5,1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#E61C1C26"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Style="{StaticResource TitleBadgeStyle}">
                    <TextBlock
                        x:Name="FieldTitle"
                        Margin="0"
                        FontSize="10"
                        Foreground="#F2F2F8"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </ToggleButton>

        <Popup
            x:Name="Pop"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=Field}"
            StaysOpen="False"
            VerticalOffset="4">
            <Border
                Padding="6"
                Background="#F2181821"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
                <ListBox
                    x:Name="List"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ItemStyle}"
                    ItemsSource="{x:Static vm:Choices.EasingOptions}"
                    SelectedValue="{Binding Value, ElementName=Root, Mode=TwoWay}"
                    SelectedValuePath="Value"
                    SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:EasingCurveIcon
                                    Width="64"
                                    Height="36"
                                    Easing="{Binding Value}" />
                                <StackPanel
                                    MaxWidth="250"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#F2F2F8"
                                        Text="{Binding Label}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="#A9A7C2"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding ShowDescriptions, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
