<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.RepeatPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Repeat properties"
    Width="491"
    Height="622"
    MinWidth="420"
    MinHeight="300"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    KeyDown="OnKeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Repeat properties"
            Height="33"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="18,10,18,6">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
            <TextBlock
                Margin="0,2,0,0"
                FontSize="11"
                Foreground="#A9A7C2"
                Text="A faint value is the value of the layer." />
        </StackPanel>

        <!--  The names of the rows stay in place, the plays scroll sideways  -->
        <Grid Grid.Row="2" Margin="18,4,18,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="LabelsGrid" VerticalAlignment="Top" />
            <ScrollViewer
                x:Name="CellsScroller"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="CellsGrid" VerticalAlignment="Top" />
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="18,6,18,14"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="110"
                Click="OnResetAll"
                Content="Reset all" />
            <ui:Button
                MinWidth="92"
                Margin="8,0,0,0"
                Appearance="Primary"
                Click="OnClose"
                Content="Close" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
