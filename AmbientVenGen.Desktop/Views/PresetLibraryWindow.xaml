<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.PresetLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    Title="Preset library"
    Width="960"
    Height="520"
    MinWidth="780"
    MinHeight="360"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False,
                                     Type=vm:PresetLibraryViewModel}"
    Background="#17171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <!--  The global TextBlock margin (see Styles.xaml) would shift the text inside table cells.  -->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  Row icon: headphones for audio, video camera for .mp4.  -->
        <Style x:Key="PresetIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Headphones24" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                    <Setter Property="Symbol" Value="Video24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Icon="pack://application:,,,/Assets/app-icon.ico" Title="Preset library" Grid.Row="0" />

        <!--  Table of presets  -->
        <ui:DataGrid
            Grid.Row="1"
            Margin="10,6,10,6"
            AutoGenerateColumns="False"
            Background="#252526"
            BorderBrush="#3F3F46"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            Foreground="White"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Presets}"
            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
            SelectionMode="Single">
            <ui:DataGrid.Columns>
                <!--  Icon + preset name  -->
                <DataGridTemplateColumn Width="230" Header="Preset">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="ToolTip" Value="The file was moved, deleted or cannot be read" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Style="{StaticResource PresetIcon}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding AddedText}"
                    Header="Added" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding DurationText}"
                    Header="Duration" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding SizeText}"
                    Header="Size" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Extension}"
                    Header="Format" />

                <!--  Waveform thumbnail (appears when it is ready)  -->
                <DataGridTemplateColumn Width="*" MinWidth="270" Header="Preview">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image
                                Width="250"
                                Height="40"
                                HorizontalAlignment="Left"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding Thumbnail}"
                                Stretch="Fill" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!--  Buttons (Add / Remove / Use)  -->
        <StackPanel
            Grid.Row="2"
            Margin="10,0,10,10"
            Orientation="Horizontal">
            <ui:Button
                Command="{Binding AddPresetCommand}"
                Style="{StaticResource ToolIconButton}"
                ToolTip="Add file">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                Command="{Binding DeletePresetCommand}"
                Style="{StaticResource ToolIconButton}"
                ToolTip="Remove from library (the file is kept)">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                Margin="12,0,0,0"
                Command="{Binding UsePresetCommand}"
                Content="Add to project"
                ToolTip="Add the selected recording to the project as a Field record layer" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
