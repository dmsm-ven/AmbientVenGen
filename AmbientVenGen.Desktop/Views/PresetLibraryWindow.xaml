<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.PresetLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Preset library"
    Width="1100"
    Height="520"
    MinWidth="1040"
    MinHeight="360"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False,
                                     Type=vm:PresetLibraryViewModel}"
    Background="#17171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Tag filter chip: a toggle that looks like a pill.  -->
        <Style x:Key="TagChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#ECECF2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Chip"
                            Margin="0,2,6,2"
                            Padding="9,2"
                            Background="#22FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#668B7CFF" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#B7AFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A text box without the theme frame (the frame is drawn around it).  -->
        <ControlTemplate x:Key="PlainTextBox" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
        </ControlTemplate>

        <!--  A table row without the theme's minimum height and padding: it is as high as its cells.  -->
        <Style x:Key="PresetRow" TargetType="DataGridRow">
            <Style.Triggers>
                <!--  Only while a tag is being typed the row is taller (the input box needs more room)  -->
                <DataTrigger Binding="{Binding IsTagEditing}" Value="True">
                    <Setter Property="Height" Value="40" />
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border
                            x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="0,0,0,1"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsControl.ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#33B7AFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A table cell without padding: the row is as high as its content.  -->
        <Style x:Key="PresetCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The global TextBlock margin (see Styles.xaml) would shift the text inside table cells.  -->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  Preview button: play, and stop while this row is playing.  -->
        <Style
            x:Key="PreviewButton"
            BasedOn="{StaticResource ToolIconButton}"
            TargetType="ui:Button">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Play preview" />
            <Setter Property="Icon">
                <Setter.Value>
                    <ui:SymbolIcon Symbol="Play24" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ToolTip" Value="Stop preview" />
                    <Setter Property="Icon">
                        <Setter.Value>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  The table takes 4/6 of the width, the tag sidebar 2/6  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Height="33"
            Grid.ColumnSpan="2"
            Title="Preset library"
            Grid.Row="0"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <controls:WindowCaptionButton Kind="Minimize" ToolTip="Minimize" />
                    <controls:WindowCaptionButton Kind="Maximize" ToolTip="Maximize" />
                    <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Under the title: Replace / Add new Layer (left), Loop, Add / Remove (right)  -->
        <Border
            Grid.Row="1"
            Margin="10,2,6,0"
            Padding="8,4"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left: what to do with the selected recording  -->
                <StackPanel Orientation="Horizontal">
                    <!--  Search by a part of the file name or of a tag; looks like an input field all the time  -->
                    <Border
                        Width="210"
                        Height="28"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="#1AFFFFFF"
                        BorderBrush="#88B7AFE9"
                        BorderThickness="1"
                        CornerRadius="6"
                        ToolTip="Words are looked for in the file name and in the tags; every word must be found (the table updates when you stop typing)">
                        <Grid>
                            <TextBox
                                x:Name="SearchBox"
                                Padding="8,0,24,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="#ECECF2"
                                FontSize="12"
                                Foreground="#ECECF2"
                                Template="{StaticResource PlainTextBox}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#7C7B94"
                                IsHitTestVisible="False"
                                Text="Search by name or tag">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ui:Button
                        VerticalAlignment="Center"
                        Command="{Binding ReplaceInLayerCommand}"
                        Content="Replace in current Layer"
                        ToolTip="Use the selected recording as the file of the selected Field record layer" />
                    <ui:Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding UsePresetCommand}"
                        Content="Add new Layer"
                        ToolTip="Add the selected recording to the project as a new Field record layer" />
                </StackPanel>

                <!--  Right: the library itself  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding AddPresetCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Add file">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding DeletePresetCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Remove from library (the file is kept)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Tag sidebar: all tags, the most used first; the presets must have every switched-on tag  -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="0,2,10,10"
            Padding="8"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            ToolTip="Filter by tags: only presets that have all the switched-on tags are shown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,6">
                    <ComboBox
                        MinWidth="104"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Label"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding DateFilters}"
                        SelectedValue="{Binding DateFilterDays, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        ToolTip="Show only the recordings added within this period" />
                    <ToggleButton
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding SortByUsage, Mode=TwoWay}"
                        Style="{StaticResource ToolIconToggleButton}"
                        ToolTip="Sort the table by use: the recordings that were added to the project most often come first">
                        <ui:SymbolIcon Symbol="ArrowSortDown24" />
                    </ToggleButton>
                    <ui:Button
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Command="{Binding ClearTagFilterCommand}"
                        Content="Clear"
                        DockPanel.Dock="Right"
                        ToolTip="Switch off all tag filters"
                        Visibility="{Binding HasTagFilter, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#C9C8D6"
                        Text="Tags" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TagFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton
                                    Content="{Binding Label}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Style="{StaticResource TagChip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Table of presets  -->
        <ui:DataGrid
            x:Name="PresetsGrid"
            Grid.Row="2"
            Margin="10,6,6,6"
            AutoGenerateColumns="False"
            Background="#252526"
            BorderBrush="#3F3F46"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            EnableRowVirtualization="True"
            FontSize="12"
            Foreground="White"
            GridLinesVisibility="None"
            CellStyle="{StaticResource PresetCell}"
            MinRowHeight="0"
            RowStyle="{StaticResource PresetRow}"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Presets}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
            SelectionChanged="OnPresetsSelectionChanged"
            SelectionMode="Extended"
            VirtualizingPanel.IsVirtualizing="True">
            <ui:DataGrid.InputBindings>
                <!--  Double click on a row = Add new Layer  -->
                <MouseBinding Command="{Binding UsePresetCommand}" MouseAction="LeftDoubleClick" />
            </ui:DataGrid.InputBindings>
            <ui:DataGrid.Columns>
                <!--  Icon + preset name  -->
                <DataGridTemplateColumn
                    Width="*"
                    MinWidth="160"
                    Header="Preset">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="ToolTip" Value="The file was moved, deleted or cannot be read" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:Button
                                    Command="{Binding DataContext.TogglePreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PreviewButton}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding DurationText}"
                    FontSize="12"
                    Header="Duration" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding SizeText}"
                    FontSize="12"
                    Header="Size" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Extension}"
                    FontSize="12"
                    Header="Format" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding ViewsCount}"
                    FontSize="12"
                    Header="Used" />


                <!--  Tags: chips + a box to add one (type a new tag or pick an existing one)  -->
                <DataGridTemplateColumn Width="250" Header="Tags">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="2,0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTagCellMouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#7C7B94"
                                    Text="+ tag"
                                    Visibility="{Binding ShowTagHint, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,1,4,1"
                                                Padding="6,0,4,0"
                                                Background="#33B7AFE9"
                                                CornerRadius="9">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="#ECECF2"
                                                        Text="{Binding}" />
                                                    <TextBlock
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        Foreground="#C9C8D6"
                                                        MouseLeftButtonUp="OnRemoveTagClick"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                        Text="x"
                                                        ToolTip="Remove tag" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="92"
                                    Height="24"
                                    Margin="4,0,4,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    IsEditable="True"
                                    IsTextSearchEnabled="False"
                                    ItemsSource="{Binding DataContext.AllTags, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    KeyDown="OnTagKeyDown"
                                    SelectionChanged="OnTagSelected"
                                    ToolTip="Add a tag: type a name and press Enter, or pick an existing one"
                                    Visibility="{Binding IsTagEditing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!--  Waveform of the active recording (the one that plays, else the selected one); always there, so nothing jumps  -->
        <Border
            Grid.Row="3"
            Height="56"
            Margin="10,0,6,10"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="6,2">
                <!--  Loop: repeat the previewed file (off: play it once)  -->
                <ToggleButton
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Loop, Mode=TwoWay}"
                    Panel.ZIndex="1"
                    Style="{StaticResource ToolIconToggleButton}"
                    ToolTip="Loop preview: repeat the previewed file (off: play it once)">
                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                </ToggleButton>
                <controls:WaveformBars
                    Margin="36,0,0,0"
                    IsPlaying="{Binding ActiveItem.IsPlaying}"
                    Peaks="{Binding ActiveItem.Peaks}"
                    Progress="{Binding ActiveItem.PlayProgress}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#7C7B94"
                    Text="{Binding ActiveItem.WaveformHint, FallbackValue='Select a recording'}" />
                <ui:ProgressRing
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding ActiveItem.IsThumbnailLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
