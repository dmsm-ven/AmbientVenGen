<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.PresetLibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Preset library"
    Width="1100"
    Height="520"
    MinWidth="1040"
    MinHeight="360"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False,
                                     Type=vm:PresetLibraryViewModel}"
    Background="#17171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Tag filter chip: a toggle that looks like a pill.  -->
        <Style x:Key="TagChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#ECECF2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Chip"
                            Margin="0,2,6,2"
                            Padding="9,2"
                            Background="#22FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#668B7CFF" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#B7AFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The global TextBlock margin (see Styles.xaml) would shift the text inside table cells.  -->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  Preview button: play, and stop while this row is playing.  -->
        <Style
            x:Key="PreviewButton"
            BasedOn="{StaticResource ToolIconButton}"
            TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Play preview" />
            <Setter Property="Icon">
                <Setter.Value>
                    <ui:SymbolIcon Symbol="Play24" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ToolTip" Value="Stop preview" />
                    <Setter Property="Icon">
                        <Setter.Value>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Preset library"
            Grid.Row="0"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico" />

        <!--  Under the title: one Loop switch for all previews  -->
        <Border
            Grid.Row="1"
            Margin="10,2,10,0"
            Padding="8,4"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        VerticalAlignment="Center"
                        IsChecked="{Binding Loop, Mode=TwoWay}"
                        Style="{StaticResource ToolIconToggleButton}"
                        ToolTip="Loop: repeat the previewed file (off: play it once)">
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                    </ToggleButton>
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#C9C8D6"
                        Text="Loop preview" />
                </StackPanel>

                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Margin="12,2,12,2"
                    Fill="#3A3945" />

                <!--  Tag filter: all tags, the most used first; the presets must have every switched-on tag  -->
                <ItemsControl
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding TagFilters}"
                    ToolTip="Filter by tags: only presets that have all the switched-on tags are shown">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Content="{Binding Label}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Style="{StaticResource TagChip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding ClearTagFilterCommand}"
                    Content="Clear"
                    ToolTip="Switch off all tag filters"
                    Visibility="{Binding HasTagFilter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!--  Table of presets  -->
        <ui:DataGrid
            Grid.Row="2"
            Margin="10,6,10,6"
            AutoGenerateColumns="False"
            Background="#252526"
            BorderBrush="#3F3F46"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            EnableRowVirtualization="True"
            Foreground="White"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Presets}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
            SelectionMode="Single"
            VirtualizingPanel.IsVirtualizing="True">
            <ui:DataGrid.InputBindings>
                <!--  Double click on a row = Add to project  -->
                <MouseBinding Command="{Binding UsePresetCommand}" MouseAction="LeftDoubleClick" />
            </ui:DataGrid.InputBindings>
            <ui:DataGrid.Columns>
                <!--  Icon + preset name  -->
                <DataGridTemplateColumn Width="200" Header="Preset">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="ToolTip" Value="The file was moved, deleted or cannot be read" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:Button
                                    Command="{Binding DataContext.TogglePreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PreviewButton}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding DurationText}"
                    Header="Duration" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding SizeText}"
                    Header="Size" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Extension}"
                    Header="Format" />


                <!--  Waveform thumbnail (appears when it is ready)  -->
                <DataGridTemplateColumn
                    Width="*"
                    MinWidth="262"
                    Header="Preview">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid
                                Width="250"
                                Height="40"
                                HorizontalAlignment="Left">
                                <Image
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Fill" />
                                <!--  Preview position: a vertical line moving over the waveform  -->
                                <Rectangle
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    Fill="#FFF2F2F8"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="{Binding PlayX}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <!--  Shown while the waveform is being prepared  -->
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True">
                                    <ui:ProgressRing.Style>
                                        <Style TargetType="ui:ProgressRing">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:ProgressRing.Style>
                                </ui:ProgressRing>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  Tags: chips + a box to add one (type a new tag or pick an existing one)  -->
                <DataGridTemplateColumn Width="250" Header="Tags">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="2"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTagCellMouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#7C7B94"
                                    Text="+ tag"
                                    Visibility="{Binding ShowTagHint, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,1,4,1"
                                                Padding="7,1,4,1"
                                                Background="#33B7AFE9"
                                                CornerRadius="9">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#ECECF2"
                                                        Text="{Binding}" />
                                                    <TextBlock
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        Foreground="#C9C8D6"
                                                        MouseLeftButtonUp="OnRemoveTagClick"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                        Text="x"
                                                        ToolTip="Remove tag" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="92"
                                    Margin="4,2,4,2"
                                    VerticalAlignment="Center"
                                    IsEditable="True"
                                    IsTextSearchEnabled="False"
                                    ItemsSource="{Binding DataContext.AllTags, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    KeyDown="OnTagKeyDown"
                                    SelectionChanged="OnTagSelected"
                                    ToolTip="Add a tag: type a name and press Enter, or pick an existing one"
                                    Visibility="{Binding IsTagEditing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!--  Buttons (Add / Remove / Use)  -->
        <StackPanel
            Grid.Row="3"
            Margin="10,0,10,10"
            Orientation="Horizontal">
            <ui:Button
                Command="{Binding AddPresetCommand}"
                Style="{StaticResource ToolIconButton}"
                ToolTip="Add file">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                Command="{Binding DeletePresetCommand}"
                Style="{StaticResource ToolIconButton}"
                ToolTip="Remove from library (the file is kept)">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                Margin="12,0,0,0"
                Command="{Binding UsePresetCommand}"
                Content="Add to project"
                ToolTip="Add the selected recording to the project as a Field record layer" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
