<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.AddLayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Add layer"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    KeyDown="OnKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--  A big tile: a click chooses it (like a radio button that answers at once)  -->
        <Style x:Key="LayerTile" TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#ECECF2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Frame"
                            Background="#14FFFFFF"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#5B9BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#335B9BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileIcon" TargetType="Path">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#9CC2FF" />
            <Setter Property="StrokeThickness" Value="3.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TileHint" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#A9A7C2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Add layer"
            Height="33"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <WrapPanel
            Grid.Row="1"
            Width="780"
            Margin="18,12,18,18"
            HorizontalAlignment="Center">
            <Button Click="OnTile" Style="{StaticResource LayerTile}" Tag="Drone">
                <StackPanel>
                    <Path Data="M6,48 C16,18 28,18 38,48 S60,78 70,48 S88,18 96,40 M6,84 L94,84" Style="{StaticResource TileIcon}" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Drone" />
                    <TextBlock Style="{StaticResource TileHint}" Text="a long, steady tone" />
                </StackPanel>
            </Button>
            <Button Click="OnTile" Style="{StaticResource LayerTile}" Tag="Pad">
                <StackPanel>
                    <Path Data="M6,80 Q50,4 94,80 M22,80 Q50,30 78,80 M38,80 Q50,56 62,80" Style="{StaticResource TileIcon}" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Choir (Pad)" />
                    <TextBlock Style="{StaticResource TileHint}" Text="a soft, layered chord" />
                </StackPanel>
            </Button>
            <Button Click="OnTile" Style="{StaticResource LayerTile}" Tag="Noise">
                <StackPanel>
                    <Path Data="M4,50 L11,28 L17,70 L24,20 L30,78 L37,34 L44,64 L51,16 L57,82 L64,40 L71,68 L78,26 L85,60 L96,46" Style="{StaticResource TileIcon}" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Noise" />
                    <TextBlock Style="{StaticResource TileHint}" Text="wind, hiss, rumble, gong" />
                </StackPanel>
            </Button>
            <Button Click="OnTile" Style="{StaticResource LayerTile}" Tag="FieldRecord">
                <StackPanel>
                    <Path Data="M40,10 H60 A10,10 0 0 1 70,20 V46 A10,10 0 0 1 60,56 H40 A10,10 0 0 1 30,46 V20 A10,10 0 0 1 40,10 Z M18,44 A32,32 0 0 0 82,44 M50,76 V90 M34,90 H66" Style="{StaticResource TileIcon}" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Field record" />
                    <TextBlock Style="{StaticResource TileHint}" Text="a recording from the library" />
                </StackPanel>
            </Button>
            <Button Click="OnTile" Style="{StaticResource LayerTile}" Tag="OpenFile">
                <StackPanel>
                    <Path Data="M6,24 H36 L44,34 H94 V84 H6 Z M6,44 H94" Style="{StaticResource TileIcon}" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Open from file" />
                    <TextBlock Style="{StaticResource TileHint}" Text="a layer saved earlier (.aflay)" />
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
