<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    Width="460"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Settings"
            Grid.Row="0"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowMaximize="False"
            ShowMinimize="False"
            ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <controls:WindowCloseButton />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,22">
            <ui:TextBlock
                Margin="0,0,0,2"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Parameter controls" />
            <ui:TextBlock
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="#A9A7C2"
                Text="How Level, Brightness, Pitch and the other parameters are edited. The choice is remembered."
                TextWrapping="Wrap" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <RadioButton
                        Margin="0,0,0,10"
                        Content="Sliders (default)"
                        GroupName="ControlStyle"
                        IsChecked="{Binding IsSliderStyle, Mode=TwoWay}" />
                    <RadioButton
                        Content="Knobs (gauge)"
                        GroupName="ControlStyle"
                        IsChecked="{Binding IsKnobStyle, Mode=TwoWay}" />

                    <!--  A live sample of the knob: click the arc or the round end buttons  -->
                    <controls:Knob
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Format="{}{0:F0} %"
                        Maximum="100"
                        Minimum="0"
                        Value="50" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#A9A7C2"
                        Text="Click the arc to set the value; the round ends set the minimum and maximum." />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
