<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.ExportOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Export"
    Width="380"
    Background="#17171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
            <Setter Property="Margin" Value="0,1,0,10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="30" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Export"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,12,16,0">
            <ui:TextBlock FontWeight="SemiBold" Text="Format" />
            <ComboBox ItemsSource="{Binding Formats}" SelectedValue="{Binding Format, Mode=TwoWay}" />

            <StackPanel Visibility="{Binding IsWav, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock FontWeight="SemiBold" Text="WAV sample format" />
                <ComboBox ItemsSource="{Binding WavSampleFormats}" SelectedValue="{Binding WavSampleFormat, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsMp3, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock FontWeight="SemiBold" Text="MP3 bitrate" />
                <ComboBox ItemsSource="{Binding Mp3Bitrates}" SelectedValue="{Binding Mp3BitrateKbps, Mode=TwoWay}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontWeight="SemiBold" Text="Fade in" />
                <ui:TextBlock
                    Grid.Column="1"
                    Foreground="#B7AFE9"
                    Text="{Binding FadeInSeconds, StringFormat={}{0:0} s}" />
            </Grid>
            <Slider Value="{Binding FadeInSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontWeight="SemiBold" Text="Fade out" />
                <ui:TextBlock
                    Grid.Column="1"
                    Foreground="#B7AFE9"
                    Text="{Binding FadeOutSeconds, StringFormat={}{0:0} s}" />
            </Grid>
            <Slider Value="{Binding FadeOutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ui:TextBlock
                Foreground="#AAA9BB"
                Text="{Binding DurationMinutes, StringFormat=Track length: {0} min (set in the main window)}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="84"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <ui:Button
                MinWidth="104"
                Appearance="Primary"
                Click="OnExportClick"
                Content="Export..."
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
