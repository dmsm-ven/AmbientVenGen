<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.Views.CommonTagWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Common tag"
    MinWidth="380"
    MaxWidth="520"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=TagBox}"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    KeyDown="OnKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Common tag"
            Height="33"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,12,24,4">
            <TextBlock
                x:Name="MessageText"
                MaxWidth="400"
                Margin="0,0,0,10"
                FontSize="14"
                TextWrapping="Wrap" />
            <!--  Type a new tag or pick an existing one  -->
            <ComboBox
                x:Name="TagBox"
                IsEditable="True"
                MaxLength="24" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="24,14,24,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="92"
                Appearance="Primary"
                Click="OnApply"
                Content="Add tag"
                IsDefault="True" />
            <ui:Button
                MinWidth="92"
                Margin="8,0,0,0"
                Click="OnSkip"
                Content="Skip"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
