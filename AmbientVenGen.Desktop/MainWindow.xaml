<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Ambient Forge"
    Width="700"
    Height="650"
    MinWidth="600"
    MinHeight="590"
    Background="#17171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,1,0,2" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#202027" />
            <Setter Property="BorderBrush" Value="#34343F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </ui:FluentWindow.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <DockPanel>
                <StackPanel>
                    <ui:TitleBar Title="Ambient Forge" />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,0,0,10" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontWeight="SemiBold" Text="Composition preset" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Settings.Presets}"
                            SelectedItem="{Binding Settings.SelectedPreset, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock FontWeight="SemiBold" Text="Duration" />
                        <ComboBox ItemsSource="{Binding Settings.DurationOptions}" SelectedItem="{Binding Settings.SelectedDurationMinutes, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#ECECF2" Text="{Binding StringFormat={}{0} minutes}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,0,10" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Sound parameters" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="Drone level" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Foreground="#B7AFE9"
                                    Text="{Binding Settings.DroneLevel, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Slider
                                Maximum="1"
                                Minimum="0"
                                TickFrequency="0.05"
                                Value="{Binding Settings.DroneLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="Atmosphere level" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Foreground="#B7AFE9"
                                    Text="{Binding Settings.AtmosphereLevel, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Slider
                                Maximum="1"
                                Minimum="0"
                                TickFrequency="0.05"
                                Value="{Binding Settings.AtmosphereLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="Brightness" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Foreground="#B7AFE9"
                                    Text="{Binding Settings.Brightness, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Slider
                                Maximum="1"
                                Minimum="0"
                                TickFrequency="0.05"
                                Value="{Binding Settings.Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="Modulation depth" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    Foreground="#B7AFE9"
                                    Text="{Binding Settings.Modulation, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Slider
                                Maximum="1"
                                Minimum="0"
                                TickFrequency="0.05"
                                Value="{Binding Settings.Modulation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,10" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Generation" />
                    <WrapPanel>
                        <ui:Button
                            MinWidth="88"
                            Margin="0,0,6,4"
                            Padding="10,5"
                            Appearance="Primary"
                            Command="{Binding PlayCommand}"
                            Content="Play" />
                        <ui:Button
                            MinWidth="88"
                            Margin="0,0,6,4"
                            Padding="10,5"
                            Command="{Binding StopCommand}"
                            Content="Stop" />
                        <ui:Button
                            MinWidth="105"
                            Margin="0,0,0,4"
                            Padding="10,5"
                            Command="{Binding RegenerateCommand}"
                            Content="Regenerate" />
                    </WrapPanel>
                    <Separator Margin="0,5,0,8" Background="#3A3945" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding ExportWavCommand}"
                            Content="Export WAV"
                            IsEnabled="{Binding IsNotExporting}" />
                        <ui:Button
                            Padding="10,5"
                            Command="{Binding ExportMp3Command}"
                            Content="Export MP3"
                            IsEnabled="{Binding IsNotExporting}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ui:TextBlock
                Margin="2,0,2,0"
                Foreground="#AAA9BB"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ui:FluentWindow>
