<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:panels="clr-namespace:AmbientVenGen.Desktop.Panels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Ambient Forge"
    Width="1220"
    Height="820"
    MinWidth="1120"
    MinHeight="720"
    controls:Hints.IsShown="{Binding ShowHints}"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The header has its own, lighter solid color (the window itself is a darker translucent Mica).  -->
        <ui:TitleBar
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            Height="33"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <controls:WindowCaptionButton Kind="Minimize" ToolTip="Minimize" />
                    <controls:WindowCaptionButton Kind="Maximize" ToolTip="Maximize" />
                    <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <panels:ToolbarPanel Grid.Row="1" />

        <!--  Top row: three groups side by side. Recording and Modulators logically belong to the selected layer.  -->
        <Grid Grid.Row="2" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <panels:RecordingPanel />
            <panels:SelectedLayerPanel Grid.Column="1" />
            <panels:ModulatorsPanel Grid.Column="2" />
        </Grid>

        <panels:TimelinePanel Grid.Row="3" />

        <panels:StatusBarPanel Grid.Row="4" />
    </Grid>
</ui:FluentWindow>
