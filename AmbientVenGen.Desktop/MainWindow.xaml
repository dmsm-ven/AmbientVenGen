<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Ambient Forge"
    Width="1220"
    Height="820"
    MinWidth="1060"
    MinHeight="720"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Generic styles (TextBlock, Slider, ComboBox, SectionCard, ToolIconButton) are in Resources/Styles.xaml. -->

        <!-- Play / Stop in one button: the icon and tooltip follow MainViewModel.IsPlaying. -->
        <Style
            x:Key="PlayStopButton"
            BasedOn="{StaticResource ToolIconButton}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="ToolTip" Value="Play (Space)" />
            <Setter Property="Icon">
                <Setter.Value>
                    <ui:SymbolIcon Symbol="Play24" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ToolTip" Value="Stop (Space)" />
                    <Setter Property="Icon">
                        <Setter.Value>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Top tool panel -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Command="{Binding TogglePlayCommand}" Style="{StaticResource PlayStopButton}" />
                    <ui:Button
                        Command="{Binding RegenerateCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Regenerate (new seed)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding NewProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="New project (Ctrl+N)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Document24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding OpenProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Open project... (Ctrl+O)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding SaveProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Save project (Ctrl+S, Ctrl+Shift+S: Save as)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding OpenPresetLibraryCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Preset library">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Library24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Export... (Ctrl+E)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <ui:TextBlock
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    Foreground="#B7AFE9"
                    Text="{Binding TimeText}" />

                <controls:SpectrumControl
                    Grid.Column="3"
                    Width="170"
                    Height="26"
                    Margin="0,0,10,0"
                    Bands="{Binding SpectrumBands}"
                    ToolTip="Spectrum" />

                <controls:LevelMeterControl
                    Grid.Column="4"
                    Width="120"
                    Height="26"
                    IsClipping="{Binding IsClipping}"
                    LevelLeft="{Binding LevelLeft}"
                    LevelRight="{Binding LevelRight}"
                    ToolTip="Master level. The red lamp lights when the mix gets too loud (over 0 dB before the limiter): lower some layers." />
            </Grid>
        </Border>

        <!-- Top row: new layer form + selected layer inspector -->
        <Grid Grid.Row="2" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- New layer -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <ui:TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="New layer" />
                        <ui:Button
                            Margin="0"
                            HorizontalAlignment="Right"
                            Command="{Binding AddLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Add layer">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <ui:TextBlock
                        Margin="0"
                        FontSize="12"
                        Foreground="#C9C8D6"
                        Text="Type" />
                    <ComboBox
                        Margin="0,2,0,8"
                        ItemsSource="{x:Static vm:Choices.LayerTypes}"
                        SelectedValue="{Binding NewLayer.Type, Mode=TwoWay}"
                        Style="{StaticResource ChoiceCombo}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:LabeledSlider
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            Format="{}{0:0} s"
                            Header="Start"
                            Maximum="{Binding Project.DurationSeconds}"
                            Minimum="0"
                            Step="1"
                            Value="{Binding NewLayer.StartSeconds, Mode=TwoWay}" />
                        <controls:LabeledSlider
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,6"
                            Format="{}{0:0} s"
                            Header="Length"
                            Maximum="{Binding Project.DurationSeconds}"
                            Minimum="5"
                            Step="1"
                            Value="{Binding NewLayer.DurationSeconds, Mode=TwoWay}" />
                        <controls:LabeledSlider
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            Format="{}{0:0} s"
                            Header="Fade in"
                            Maximum="{Binding NewLayer.DurationSeconds}"
                            Minimum="0"
                            Step="1"
                            Value="{Binding NewLayer.FadeInSeconds, Mode=TwoWay}" />
                        <controls:LabeledSlider
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,0,6"
                            Format="{}{0:0} s"
                            Header="Fade out"
                            Maximum="{Binding NewLayer.DurationSeconds}"
                            Minimum="0"
                            Step="1"
                            Value="{Binding NewLayer.FadeOutSeconds, Mode=TwoWay}" />
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <ui:TextBlock
                                Margin="0"
                                FontSize="12"
                                Foreground="#C9C8D6"
                                Text="Transition curve" />
                            <ComboBox
                                ItemsSource="{x:Static vm:Choices.Easings}"
                                SelectedValue="{Binding NewLayer.FadeEasing, Mode=TwoWay}"
                                Style="{StaticResource ChoiceCombo}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Selected layer inspector -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <ui:TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Selected layer" />
                        <ui:Button
                            Margin="0"
                            HorizontalAlignment="Right"
                            Command="{Binding DeleteSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Remove layer (Del)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <ui:TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#AAA9BB"
                        Text="Click a layer on the timeline to edit it"
                        Visibility="{Binding IsLayerSelectionEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ContentControl Grid.Row="1" Content="{Binding SelectedLayer}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Name / type / mute -->
                                    <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            MaxLength="32"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBlock
                                            Grid.Column="1"
                                            Margin="14,0,14,0"
                                            VerticalAlignment="Center"
                                            Foreground="#B7AFE9"
                                            Text="{Binding TypeLabel}" />
                                        <CheckBox
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Content="Muted"
                                            IsChecked="{Binding Muted, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Parameters that move over the layer: from -> to along a curve -->
                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="124" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ui:TextBlock
                                            Grid.Row="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Level" />
                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,10,8"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding LevelFrom, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,0,10,8"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding LevelTo, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Margin="0,0,0,8"
                                            VerticalAlignment="Bottom"
                                            ItemsSource="{x:Static vm:Choices.Easings}"
                                            SelectedValue="{Binding LevelEasing, Mode=TwoWay}"
                                            Style="{StaticResource ChoiceCombo}" />

                                        <ui:TextBlock
                                            Grid.Row="1"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Brightness" />
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,10,8"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding BrightnessFrom, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,10,8"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding BrightnessTo, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="0,0,0,8"
                                            VerticalAlignment="Bottom"
                                            ItemsSource="{x:Static vm:Choices.Easings}"
                                            SelectedValue="{Binding BrightnessEasing, Mode=TwoWay}"
                                            Style="{StaticResource ChoiceCombo}" />

                                        <ui:TextBlock
                                            Grid.Row="2"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Modulation" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,0,10,0"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding ModulationFrom, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,10,0"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding ModulationTo, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            VerticalAlignment="Bottom"
                                            ItemsSource="{x:Static vm:Choices.Easings}"
                                            SelectedValue="{Binding ModulationEasing, Mode=TwoWay}"
                                            Style="{StaticResource ChoiceCombo}" />
                                    </Grid>

                                    <!-- Placement, fades, pitch, pan -->
                                    <Grid Grid.Row="1" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,0,6"
                                            Format="{}{0:0.0} Hz"
                                            Header="Pitch"
                                            Maximum="440"
                                            Minimum="20"
                                            Step="0.1"
                                            Value="{Binding PitchHz, Mode=TwoWay}">
                                            <controls:LabeledSlider.Style>
                                                <Style TargetType="controls:LabeledSlider">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Noise">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LabeledSlider.Style>
                                        </controls:LabeledSlider>
                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,0,0,6"
                                            Format="{}{0:+0.00;-0.00;0.00}"
                                            Header="Pan"
                                            Maximum="1"
                                            Minimum="-1"
                                            Step="0.05"
                                            Value="{Binding Pan, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,0,6"
                                            Format="{}{0:0} s"
                                            Header="Start"
                                            Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Minimum="0"
                                            Step="1"
                                            Value="{Binding StartSeconds, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,6"
                                            Format="{}{0:0} s"
                                            Header="Length"
                                            Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Minimum="2"
                                            Step="1"
                                            Value="{Binding DurationSeconds, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,0,0,6"
                                            Format="{}{0:0} s"
                                            Header="Fade in"
                                            Maximum="{Binding DurationSeconds}"
                                            Minimum="0"
                                            Step="1"
                                            Value="{Binding FadeInSeconds, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,0,6"
                                            Format="{}{0:0} s"
                                            Header="Fade out"
                                            Maximum="{Binding DurationSeconds}"
                                            Minimum="0"
                                            Step="1"
                                            Value="{Binding FadeOutSeconds, Mode=TwoWay}" />
                                        <StackPanel Grid.Row="3" Grid.Column="0">
                                            <ui:TextBlock
                                                Margin="0"
                                                FontSize="12"
                                                Foreground="#C9C8D6"
                                                Text="Transition curve" />
                                            <ComboBox
                                                ItemsSource="{x:Static vm:Choices.Easings}"
                                                SelectedValue="{Binding FadeEasing, Mode=TwoWay}"
                                                Style="{StaticResource ChoiceCombo}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline -->
        <Border
            Grid.Row="3"
            Margin="12,10,12,0"
            Padding="0"
            Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline" />

                    <controls:LabeledSlider
                        Grid.Column="2"
                        Width="190"
                        Margin="0,0,24,0"
                        Format="{}{0:P0}"
                        Header="Space (reverb)"
                        Maximum="1"
                        Minimum="0"
                        Step="0.01"
                        Value="{Binding Project.ReverbMix, Mode=TwoWay}" />

                    <StackPanel Grid.Column="3" Width="170">
                        <ui:TextBlock
                            Margin="0"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Template" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Templates}"
                            SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="4"
                        Margin="6,0,24,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding ApplyTemplateCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Apply template (replaces all layers)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Checkmark24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <StackPanel Grid.Column="5" Width="110">
                        <ui:TextBlock
                            Margin="0"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Track length" />
                        <ComboBox
                            ItemsSource="{Binding LengthOptions}"
                            SelectedValue="{Binding Project.DurationSeconds, Mode=TwoWay}"
                            Style="{StaticResource ChoiceCombo}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <controls:TimelineControl
                        DeleteCommand="{Binding DeleteSelectedLayerCommand}"
                        PlayheadSeconds="{Binding PlayheadSeconds}"
                        Project="{Binding Project}"
                        SeekCommand="{Binding SeekCommand}"
                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status line + export progress -->
        <Border
            Grid.Row="4"
            Margin="0,10,0,0"
            Padding="16,6"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    Foreground="#AAA9BB"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        Width="200"
                        Height="6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding ExportProgress, Mode=OneWay}" />
                    <ui:Button
                        Margin="0"
                        Command="{Binding CancelExportCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Cancel export">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
