<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Ambient Forge"
    Width="1220"
    Height="820"
    MinWidth="1120"
    MinHeight="720"
    controls:Hints.IsShown="{Binding ShowHints}"
    controls:InputStyle.UseKnobs="{Binding Settings.UseKnobs}"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One row of the pitch interval table: [name = link] | [multiplier] | [resulting pitch] -->
        <DataTemplate x:Key="IntervalRowTemplate">
                                        <!-- A blue border marks the interval the layer has right now -->
                                        <Border
                                            Margin="0,1"
                                            Padding="4,0"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF5B9BFF" />
                                                            <Setter Property="Background" Value="#1A5B9BFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                                <Grid Margin="0" ToolTip="{Binding Interval.Description}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- The name works like a link: click it to apply the interval -->
                                                    <Border
                                                        Padding="0,2"
                                                        Background="Transparent"
                                                        Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding
                                                                Command="{Binding DataContext.ApplyIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                MouseAction="LeftClick" />
                                                        </Border.InputBindings>
                                                        <TextBlock
                                                            Margin="0"
                                                            FontSize="12"
                                                            Text="{Binding Interval.Name}">
                                                            <TextBlock.Style>
                                                                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#B7AFE9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#8F8DB0"
                                                        Text="{Binding Interval.Ratio, StringFormat='&#215;{0:0.###}'}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#8FD16A"
                                                        Text="{Binding HzText}" />
                                                </Grid>
                                        </Border>
                                        </DataTemplate>
        <controls:GreaterThanOneConverter x:Key="GreaterThanOne" />

        <!--  Generic styles (TextBlock, Slider, ComboBox, SectionCard, ToolIconButton) are in Resources/Styles.xaml.  -->

        <!--  Play / Stop in one button: the icon and tooltip follow MainViewModel.IsPlaying.  -->
        <Style
            x:Key="PlayStopButton"
            BasedOn="{StaticResource TimelineIconButton}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="ToolTip" Value="Play (Space)" />
            <Setter Property="Icon">
                <Setter.Value>
                    <ui:SymbolIcon Symbol="Play24" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ToolTip" Value="Stop (Space)" />
                    <Setter Property="Icon">
                        <Setter.Value>
                            <ui:SymbolIcon Symbol="Stop24" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The header has its own, lighter solid color (the window itself is a darker translucent Mica).  -->
        <ui:TitleBar
            Height="33"
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <controls:WindowCaptionButton Kind="Minimize" ToolTip="Minimize" />
                    <controls:WindowCaptionButton Kind="Maximize" ToolTip="Maximize" />
                    <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Top tool panel  -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding NewProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="New project (Ctrl+N)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Document24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding OpenProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Open project... (Ctrl+O)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding SaveProjectCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Save project (Ctrl+S, Ctrl+Shift+S: Save as)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding OpenPresetLibraryCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Preset library">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Library24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Export... (Ctrl+E)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Settings">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ToggleButton
                        IsChecked="{Binding ShowHints, Mode=TwoWay}"
                        Style="{StaticResource ToolIconToggleButton}"
                        ToolTip="Show hints: a '?' appears next to each parameter">
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </ToggleButton>
                </StackPanel>

                <ui:TextBlock
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    Foreground="#B7AFE9"
                    Text="{Binding TimeText}" />

                <controls:SpectrumControl
                    Grid.Column="3"
                    Width="170"
                    Height="26"
                    Margin="0,0,10,0"
                    Bands="{Binding SpectrumBands}"
                    ToolTip="Spectrum" />

                <controls:LevelMeterControl
                    Grid.Column="4"
                    Width="120"
                    Height="26"
                    IsClipping="{Binding IsClipping}"
                    LevelLeft="{Binding LevelLeft}"
                    LevelRight="{Binding LevelRight}"
                    ToolTip="Master level. The red lamp lights when the mix gets too loud (over 0 dB before the limiter): lower some layers." />
            </Grid>
        </Border>

        <!--  Top row: new layer form + selected layer inspector  -->
        <Grid Grid.Row="2" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  New layer: only the type; start, length and fades are edited after adding  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="New layer" />
                            <ui:Button
                                Margin="0,0,30,0"
                                HorizontalAlignment="Right"
                                Command="{Binding UndoDeleteCommand}"
                                Style="{StaticResource ToolIconButton}"
                                ToolTip="Restore the last removed layer">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUndo24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                Margin="0"
                                HorizontalAlignment="Right"
                                Command="{Binding AddLayerCommand}"
                                Style="{StaticResource ToolIconButton}"
                                ToolTip="Add layer">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                                Margin="0"
                                FontSize="12"
                                Foreground="#C9C8D6"
                                Text="Type" />
                            <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.LayerType}" />
                        </StackPanel>
                        <ComboBox
                            ItemsSource="{x:Static vm:Choices.LayerTypes}"
                            SelectedValue="{Binding NewLayer.Type, Mode=TwoWay}"
                            Style="{StaticResource ChoiceCombo}" />
                    </StackPanel>
                </Border>

                <!--  Templates: a ready-made set of layers  -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <ui:TextBlock
                                Margin="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Template" />
                            <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Template}" />
                        </StackPanel>
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Templates}"
                            SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ApplyTemplateCommand}"
                            Content="Apply template"
                            ToolTip="Replaces all layers of the project with the template" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Selected layer inspector  -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <!--  Title, layer type and the type-specific field: noise colour or the source file of a recording  -->
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Selected layer" />
                            <ui:TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#B7AFE9"
                                Text="{Binding SelectedLayer.TypeLabel}" />

                            <!--  Noise: the colour of the noise  -->
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayer.Type}" Value="Noise">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                                <controls:NoiseTypeDropdown VerticalAlignment="Center" Value="{Binding SelectedLayer.NoiseType, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  Field record: the file; a click on its name chooses another one  -->
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayer.Type}" Value="FieldRecord">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                                <controls:HintIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static vm:HintTexts.Source}" />
                                <ui:TextBlock
                                    MaxWidth="260"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Foreground="#7FB2FF"
                                    Text="{Binding SelectedLayer.SourceName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="Click to choose another file">
                                    <ui:TextBlock.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.ChangeSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick" />
                                    </ui:TextBlock.InputBindings>
                                    <ui:TextBlock.TextDecorations>
                                        <TextDecoration Location="Underline">
                                            <TextDecoration.Pen>
                                                <Pen Brush="#997FB2FF" Thickness="1">
                                                    <Pen.DashStyle>
                                                        <DashStyle Dashes="1 2" />
                                                    </Pen.DashStyle>
                                                </Pen>
                                            </TextDecoration.Pen>
                                        </TextDecoration>
                                    </ui:TextBlock.TextDecorations>
                                </ui:TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <!-- Pitch interval: header (source layer) / body (interval) / footer (Apply) -->
                        <ui:Button
                            x:Name="IntervalButton"
                            Margin="0,0,60,0"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenIntervalPanelCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Pitch interval: set this layer's pitch relative to another Drone / Pad layer (needs at least two of them)"
                            ToolTipService.ShowOnDisabled="True">
                            <!--  A tuning fork  -->
                            <Path
                                Width="16"
                                Height="16"
                                Data="M5,1 L5,8 A3,3 0 0 0 11,8 L11,1 M8,11 L8,15"
                                Stretch="Uniform"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </ui:Button>
                        <Popup
                            x:Name="IntervalPopup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsIntervalPanelOpen, Mode=TwoWay}"
                            Placement="Custom"
                            PlacementTarget="{Binding ElementName=IntervalButton}"
                            StaysOpen="False">
                            <Border
                                Width="320"
                                Background="#F2181821"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <!-- Header: the layer the pitch is taken from -->
                                    <StackPanel Margin="14,10,14,12">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#C9C8D6"
                                                Text="Take the pitch from layer" />
                                            <ui:Button
                                                Margin="0,-4,-8,0"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Appearance="Transparent"
                                                Command="{Binding CloseIntervalPanelCommand}"
                                                Content="&#10005;"
                                                ToolTip="Close" />
                                        </Grid>
                                        <ComboBox
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding IntervalSources}"
                                            SelectedItem="{Binding IntervalSource, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Border Height="1" Background="#2EFFFFFF" />
                                    <!-- Body: all intervals at once; [name = link] | [multiplier] | [resulting pitch] -->
                                    <ItemsControl
                                        Margin="14,8,14,6"
                                        ItemTemplate="{StaticResource IntervalRowTemplate}"
                                        ItemsSource="{Binding IntervalRows}" />
                                    <Border Height="1" Background="#2EFFFFFF" />
                                    <!-- Second group: mathematical ratios, smallest first; open or closed state is remembered in the settings -->
                                    <Expander
                                        Margin="10,4,10,8"
                                        FontSize="11"
                                        Header="Mathematical ratios"
                                        IsExpanded="{Binding Settings.IntervalMathExpanded, Mode=TwoWay}">
                                        <!-- Tall enough for the whole group; a scroll bar appears only on a very low screen and gets its own margin -->
                                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl
                                                Margin="4,2,18,0"
                                                ItemTemplate="{StaticResource IntervalRowTemplate}"
                                                ItemsSource="{Binding MathIntervalRows}" />
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ui:Button
                            Margin="0,0,30,0"
                            HorizontalAlignment="Right"
                            Command="{Binding RandomizeSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Randomize all sound settings of this layer">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowShuffle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Margin="0"
                            HorizontalAlignment="Right"
                            Command="{Binding DeleteSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Remove layer (Del)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <ContentControl Grid.Row="1" Content="{Binding SelectedLayer}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="4*" MinWidth="440" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Name / type / mute / placement  -->
                                    <Grid
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            VerticalAlignment="Top"
                                            MaxLength="32"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton
                                            Grid.Column="2"
                                            Margin="14,2,22,0"
                                            VerticalAlignment="Top"
                                            IsChecked="{Binding Muted, Mode=TwoWay}"
                                            Style="{StaticResource MuteToggleButton}">
                                            <ui:SymbolIcon>
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Speaker224" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                <Setter Property="Symbol" Value="SpeakerOff24" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ToggleButton>
                                        <!--  Start and Duration on one line: caption left of the time  -->
                                        <StackPanel
                                            Grid.Column="3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <controls:TimeBox
                                                Margin="0,0,18,0"
                                                Header="Start"
                                                Hint="{x:Static vm:HintTexts.Start}"
                                                IsInline="True"
                                                Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Minimum="0"
                                                Value="{Binding StartSeconds, Mode=TwoWay}" />
                                            <controls:TimeBox
                                                Header="Duration"
                                                Hint="{x:Static vm:HintTexts.Duration}"
                                                IsInline="True"
                                                Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,0,0"
                                                Minimum="2"
                                                Value="{Binding DurationSeconds, Mode=TwoWay}" />
                                            <!-- Repeats: how many plays, the pause between them and the resulting length -->
                                            <StackPanel Margin="18,0,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#C9C8D6"
                                                    Text="Repeats" />
                                                <controls:HintIcon Margin="5,0,0,0" VerticalAlignment="Center" Text="{x:Static vm:HintTexts.Repeats}" />
                                                <TextBox
                                                    Width="48"
                                                    Margin="8,0,18,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    MaxLength="2"
                                                    Text="{Binding Repeats, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    ToolTip="1 - 99" />
                                                <controls:TimeBox
                                                    Margin="0,0,14,0"
                                                    Header="Gap"
                                                    Hint="{x:Static vm:HintTexts.RepeatGap}"
                                                    IsInline="True"
                                                    Maximum="3600"
                                                    Minimum="0"
                                                    Value="{Binding RepeatGapSeconds, Mode=TwoWay}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="#8FD16A"
                                                    Text="{Binding TotalSeconds, StringFormat='= {0:0.#} s'}"
                                                    ToolTip="Whole length of the layer with repeats">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Repeats, Converter={StaticResource GreaterThanOne}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!--  Parameters that move over the layer: [from] - chain / curve - [to]  -->
                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding LevelFrom, Mode=TwoWay}" />

                                        <!--  Between the two knobs: name, chain (they belong together) and the curve of the change  -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,6"
                                            VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0"
                                                    FontWeight="SemiBold"
                                                    Text="Level" />
                                                <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Level}" />
                                            </StackPanel>
                                            <Grid Margin="0,3,0,0" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                                <controls:TransitionFunctionDropdown Grid.Column="1" Value="{Binding LevelEasing, Mode=TwoWay}" />
                                                <ui:SymbolIcon
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                            </Grid>
                                        </StackPanel>

                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="6,0,0,6"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding LevelTo, Mode=TwoWay}" />

                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding BrightnessFrom, Mode=TwoWay}" />

                                        <!--  Between the two knobs: name, chain (they belong together) and the curve of the change  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,0,6"
                                            VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0"
                                                    FontWeight="SemiBold"
                                                    Text="Brightness" />
                                                <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Brightness}" />
                                            </StackPanel>
                                            <Grid Margin="0,3,0,0" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                                <controls:TransitionFunctionDropdown Grid.Column="1" Value="{Binding BrightnessEasing, Mode=TwoWay}" />
                                                <ui:SymbolIcon
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                            </Grid>
                                        </StackPanel>

                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="6,0,0,6"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding BrightnessTo, Mode=TwoWay}" />

                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="From"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding ModulationFrom, Mode=TwoWay}" />

                                        <!--  Between the two knobs: name, chain (they belong together) and the curve of the change  -->
                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0"
                                                    FontWeight="SemiBold"
                                                    Text="Modulation" />
                                                <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Modulation}" />
                                            </StackPanel>
                                            <Grid Margin="0,3,0,0" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                                <controls:TransitionFunctionDropdown Grid.Column="1" Value="{Binding ModulationEasing, Mode=TwoWay}" />
                                                <ui:SymbolIcon
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: the value moves from the left one to the right one over the layer, along this curve" />
                                            </Grid>
                                        </StackPanel>

                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="6,0,0,6"
                                            Format="{}{0:P0}"
                                            Header="To"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding ModulationTo, Mode=TwoWay}" />

                                        <!--  Fade in / out: the same pattern, one curve for both  -->
                                        <controls:LabeledSlider
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Format="{}{0:0} s"
                                            Header="Fade in"
                                            Maximum="{Binding DurationSeconds}"
                                            Minimum="0"
                                            Step="1"
                                            Value="{Binding FadeInSeconds, Mode=TwoWay}" />

                                        <!--  Between the two knobs: name, chain (they belong together) and the curve of the change  -->
                                        <StackPanel
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0"
                                                    FontWeight="SemiBold"
                                                    Text="Fade" />
                                                <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.FadeInOut}" />
                                            </StackPanel>
                                            <Grid Margin="0,3,0,0" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: fade-in and fade-out share one curve" />
                                                <controls:TransitionFunctionDropdown Grid.Column="1" Value="{Binding FadeEasing, Mode=TwoWay}" />
                                                <ui:SymbolIcon
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="#8F8DB0"
                                                    Symbol="Link24"
                                                    ToolTip="Linked: fade-in and fade-out share one curve" />
                                            </Grid>
                                        </StackPanel>

                                        <controls:LabeledSlider
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            Format="{}{0:0} s"
                                            Header="Fade out"
                                            Maximum="{Binding DurationSeconds}"
                                            Minimum="0"
                                            Step="1"
                                            Value="{Binding FadeOutSeconds, Mode=TwoWay}" />
                                    </Grid>

                                    <!--
                                        Everything that is not animated over the layer, a row = a group of related knobs:
                                          1. Pitch:        Pitch (Speed for a recording) | Pitch drift;  unavailable knobs are hidden
                                          2. Place, space: Pan | Pan drift | Reverb send
                                          3. Filter:       Cutoff | Resonance
                                          4. Echo:         Delay | Feedback
                                    -->
                                    <Grid Grid.Row="1" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:0.0} Hz"
                                            Header="Pitch"
                                            Hint="{x:Static vm:HintTexts.Pitch}"
                                            IsLogarithmic="True"
                                            IsValueEditable="True"
                                            Maximum="1000"
                                            Minimum="20"
                                            Step="0.1"
                                            Value="{Binding PitchHz, Mode=TwoWay}">
                                            <controls:LabeledSlider.Style>
                                                <Style TargetType="controls:LabeledSlider">
                                                    <Style.Triggers>
                                                        <!--  Noise has no pitch and a recording has Speed in this very place: hidden  -->
                                                        <DataTrigger Binding="{Binding Type}" Value="Noise">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="FieldRecord">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LabeledSlider.Style>
                                        </controls:LabeledSlider>
                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="Pitch drift"
                                            Hint="{x:Static vm:HintTexts.PitchDrift}"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding PitchDrift, Mode=TwoWay}">
                                            <controls:LabeledSlider.Style>
                                                <Style TargetType="controls:LabeledSlider">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Noise">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LabeledSlider.Style>
                                        </controls:LabeledSlider>
                                        <controls:LabeledSlider
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:0.00}x"
                                            Header="Speed"
                                            Hint="{x:Static vm:HintTexts.Speed}"
                                            IsLogarithmic="True"
                                            IsValueEditable="True"
                                            Maximum="4"
                                            Minimum="0.25"
                                            Step="0.01"
                                            Value="{Binding Speed, Mode=TwoWay}">
                                            <controls:LabeledSlider.Style>
                                                <Style TargetType="controls:LabeledSlider">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="FieldRecord">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:LabeledSlider.Style>
                                        </controls:LabeledSlider>
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:+0.00;-0.00;0.00}"
                                            Header="Pan"
                                            Hint="{x:Static vm:HintTexts.Pan}"
                                            Maximum="1"
                                            Minimum="-1"
                                            Step="0.05"
                                            Value="{Binding Pan, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="Pan drift"
                                            Hint="{x:Static vm:HintTexts.PanDrift}"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding PanDrift, Mode=TwoWay}" />

                                        <controls:LabeledSlider
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,6"
                                            Format="{}{0:P0}"
                                            Header="Reverb send"
                                            Hint="{x:Static vm:HintTexts.ReverbSend}"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding ReverbSend, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,0,6,6"
                                            Format="{}{0:0} Hz"
                                            Header="Cutoff"
                                            Hint="{x:Static vm:HintTexts.Cutoff}"
                                            IsLogarithmic="True"
                                            IsValueEditable="True"
                                            Maximum="20000"
                                            Minimum="20"
                                            Step="1"
                                            Value="{Binding FilterCutoffHz, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,0,6,6"
                                            Format="{}{0:P0}"
                                            Header="Resonance"
                                            Hint="{x:Static vm:HintTexts.Resonance}"
                                            Maximum="1"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding FilterResonance, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Format="{}{0:0.00} s"
                                            Header="Delay"
                                            Hint="{x:Static vm:HintTexts.Delay}"
                                            IsValueEditable="True"
                                            Maximum="2"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding DelaySeconds, Mode=TwoWay}" />
                                        <controls:LabeledSlider
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Format="{}{0:P0}"
                                            Header="Feedback"
                                            Hint="{x:Static vm:HintTexts.Feedback}"
                                            Maximum="0.92"
                                            Minimum="0"
                                            Step="0.01"
                                            Value="{Binding DelayFeedback, Mode=TwoWay}" />

                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!--  Timeline  -->
        <Border
            Grid.Row="3"
            Margin="12,10,12,0"
            Padding="0"
            Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,5,14,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Title with Play / Stop and Seed under it  -->
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock
                            Margin="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Timeline" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <ui:Button Command="{Binding TogglePlayCommand}" Style="{StaticResource PlayStopButton}" />
                            <ui:Button
                                Command="{Binding RegenerateCommand}"
                                Style="{StaticResource TimelineIconButton}"
                                ToolTip="Regenerate (new seed)">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>

                    <controls:LabeledSlider
                        Grid.Column="2"
                        Width="190"
                        Margin="0,0,24,0"
                        VerticalAlignment="Bottom"
                        Format="{}{0:P0}"
                        Header="Space (reverb)"
                        Hint="{x:Static vm:HintTexts.Reverb}"
                        Maximum="1"
                        Minimum="0"
                        Step="0.01"
                        UseKnobs="False"
                        Value="{Binding Project.ReverbMix, Mode=TwoWay}" />

                    <StackPanel
                        Grid.Column="3"
                        Width="110"
                        VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                                Margin="0"
                                FontSize="12"
                                Foreground="#C9C8D6"
                                Text="Track length" />
                            <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.TrackLength}" />
                        </StackPanel>
                        <ComboBox
                            ItemsSource="{Binding LengthOptions}"
                            SelectedValue="{Binding Project.DurationSeconds, Mode=TwoWay}"
                            Style="{StaticResource ChoiceCombo}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <controls:TimelineControl
                        DeleteCommand="{Binding DeleteSelectedLayerCommand}"
                        PlayheadSeconds="{Binding PlayheadSeconds}"
                        Project="{Binding Project}"
                        SeekCommand="{Binding SeekCommand}"
                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Status line + export progress  -->
        <Border
            Grid.Row="4"
            Margin="0,10,0,0"
            Padding="16,6"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    Foreground="#AAA9BB"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        Width="200"
                        Height="6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding ExportProgress, Mode=OneWay}" />
                    <ui:Button
                        Margin="0"
                        Command="{Binding CancelExportCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Cancel export">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
