<ui:FluentWindow
    x:Class="AmbientVenGen.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:panels="clr-namespace:AmbientVenGen.Desktop.Panels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels"
    Title="Ambient Forge"
    Width="1220"
    Height="820"
    MinWidth="1120"
    MinHeight="720"
    controls:Hints.IsShown="{Binding ShowHints}"
    Background="#E617171D"
    ExtendsContentIntoTitleBar="True"
    Foreground="#ECECF2"
    Icon="pack://application:,,,/Assets/app-icon.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                Both main sections are proportional (star), so the height of the top groups does not depend on their
                content (switching the layer type hides the Recording group) - only the splitter changes it.
            -->
            <RowDefinition Height="5*" MinHeight="200" />
            <RowDefinition Height="6" />
            <RowDefinition Height="4*" MinHeight="220" />
        </Grid.RowDefinitions>

        <!--  The header has its own, lighter solid color (the window itself is a darker translucent Mica).  -->
        <ui:TitleBar
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            Height="33"
            Background="{StaticResource WindowTitleBackground}"
            ButtonsBackground="{StaticResource WindowTitleButtonsBackground}"
            ButtonsForeground="{StaticResource WindowTitleButtonsForeground}"
            Icon="pack://application:,,,/Assets/app-icon.ico"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <controls:WindowCaptionButton Kind="Minimize" ToolTip="Minimize" />
                    <controls:WindowCaptionButton Kind="Maximize" ToolTip="Maximize" />
                    <controls:WindowCaptionButton Kind="Close" ToolTip="Close" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <panels:ToolbarPanel Grid.Row="1" />

        <!--
            The editor groups are created only when a project is opened (Content is set then): until that the start
            screen is all there is, and nothing of the editor or the timeline is loaded.
        -->
        <ContentControl Grid.Row="2" IsTabStop="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStartScreen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Content" Value="{Binding}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10,6,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  The bars fold the side groups: the Selected Layer group in the middle gets all the room  -->
                <ToggleButton
                    Margin="0,0,6,0"
                    Content="Source"
                    IsChecked="{Binding Settings.LeftPanelOpen, Mode=TwoWay}"
                    Style="{StaticResource SideToggleLeft}"
                    ToolTip="Show / hide the Recording, Noise and Interval group" />
                <Grid Grid.Column="1" Visibility="{Binding Settings.LeftPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <panels:RecordingPanel />
                    <panels:NoisePanel />
                    <panels:IntervalPanel />
                </Grid>
                <panels:SelectedLayerPanel Grid.Column="2" />
                <TabControl
                    Grid.Column="3"
                    SelectedIndex="{Binding SideTabIndex, Mode=TwoWay}"
                    Style="{StaticResource SideTabControl}"
                    Visibility="{Binding Settings.RightPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <TabItem Header="Oscillators">
                        <panels:ModulatorsPanel />
                    </TabItem>
                    <TabItem Header="Events">
                        <panels:EventsPanel />
                    </TabItem>
                </TabControl>
                <ToggleButton
                    Grid.Column="4"
                    Margin="6,0,0,0"
                    Content="Oscillators / Events"
                    IsChecked="{Binding Settings.RightPanelOpen, Mode=TwoWay}"
                    Style="{StaticResource SideToggleRight}"
                    ToolTip="Show / hide the Oscillators and Events group" />
            </Grid>
                    </ScrollViewer>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!--  Start screen: the recent projects instead of the editor groups until a project is opened  -->
        <panels:StartScreenPanel
            Grid.Row="2"
            Grid.RowSpan="3"
            Visibility="{Binding ShowStartScreen, Converter={StaticResource BoolToVisibility}}" />

        <!--  The only splitter: the height of the top groups against the timeline  -->
        <GridSplitter
            Grid.Row="3"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeNS"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            ShowsPreview="False">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStartScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <ContentControl Grid.Row="4" IsTabStop="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStartScreen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Content" Value="{Binding}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <panels:TimelinePanel />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</ui:FluentWindow>
