<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.ToolbarPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Top tool panel: project, library, layer, export, master level  -->
        <Border
            Padding="12,6"
            Background="#661C1C24"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button
                        Click="OnOpenMenuClick"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="New / open project (Ctrl+N: new, Ctrl+O: open file)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding SaveProjectCommand}"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="Save project (Ctrl+S, Ctrl+Shift+S: Save as)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding AddLayerCommand}"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="Add layer (the type is chosen in the free row of the timeline)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Layer24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding OpenPresetLibraryCommand}"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="Preset library">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Library24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="Export... (Ctrl+E)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0,10,0"
                        Fill="#3A3945" />
                    <ui:Button
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource TopToolButton}"
                        ToolTip="Settings">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ToggleButton
                        IsChecked="{Binding ShowHints, Mode=TwoWay}"
                        Style="{StaticResource TopToolToggleButton}"
                        ToolTip="Show hints: a '?' appears next to each parameter">
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Whole project: position / length  -->
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="#B7AFE9"
                        Text="{Binding TimeText}" />
                    <!--  The playback position inside the selected layer, with milliseconds  -->
                    <ui:TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="#E6D25A"
                        Text="{Binding SelectedLayerTimeText}"
                        ToolTip="Playback position inside the selected layer (minutes:seconds.milliseconds)" />
                </StackPanel>

                <controls:SpectrumControl
                    Grid.Column="3"
                    Width="170"
                    Height="26"
                    Margin="0,0,10,0"
                    Bands="{Binding SpectrumBands}"
                    ToolTip="Spectrum" />

                <controls:LevelMeterControl
                    Grid.Column="4"
                    Width="120"
                    Height="26"
                    IsClipping="{Binding IsClipping}"
                    LevelLeft="{Binding LevelLeft}"
                    LevelRight="{Binding LevelRight}"
                    ToolTip="Master level. The red lamp lights when the mix gets too loud (over 0 dB before the limiter): lower some layers." />
            </Grid>
        </Border>
</UserControl>
