<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.EventsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:core="clr-namespace:AmbientVenGen.Core.Composition;assembly=AmbientVenGen.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--
        The events (one-shot effects) of the selected layer. The tiles on top add an event at the playhead (a click) or
        at the place where they are dropped on a layer of the timeline (a drag).
    -->
    <UserControl.Resources>
        <Style x:Key="EventTile" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                    <Setter Property="BorderBrush" Value="#5B9BFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border
        Margin="6,0,0,0"
        IsEnabled="{Binding HasSelectedLayer}"
        Style="{StaticResource SectionCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="7">
                <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="EchoThrow"
                    ToolTip="Echo throw: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="EchoThrow"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="Stutter"
                    ToolTip="Stutter: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="Stutter"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                            <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="FilterSweep"
                    ToolTip="Filter sweep: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="FilterSweep"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                            <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="Freeze"
                    ToolTip="Freeze: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="Freeze"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                            <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="PitchDive"
                    ToolTip="Pitch dive: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="PitchDive"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                            <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="SwellDuck"
                    ToolTip="Swell / Duck: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="SwellDuck"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                            <Border
                    MouseLeftButtonDown="OnTileDown"
                    MouseLeftButtonUp="OnTileUp"
                    MouseMove="OnTileMove"
                    Style="{StaticResource EventTile}"
                    Tag="BitcrushBurst"
                    ToolTip="Bitcrush burst: click to add at the playhead, or drag onto a layer of the timeline">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ModGlyph
                            Width="20"
                            Height="20"
                            Key="BitcrushBurst"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  An invisible oscillator editor: this tab is as wide as the Oscillators tab, the group does not change its width  -->
            <controls:ModulatorEditor
                Grid.Row="1"
                Height="0"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Hidden">
                <controls:ModulatorEditor.DataContext>
                    <core:Modulator RateHz="0.005" Target="Modulation" />
                </controls:ModulatorEditor.DataContext>
            </controls:ModulatorEditor>
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedLayer.Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:EventEditor Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
