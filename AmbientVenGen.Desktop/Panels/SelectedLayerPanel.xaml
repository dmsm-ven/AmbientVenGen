<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.SelectedLayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Inspector of the selected layer  -->
            <Border
                IsEnabled="{Binding HasSelectedLayer}"
                Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <!--  Title, layer type and the type-specific field: noise colour or the source file of a recording  -->
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Selected layer" />
                            <ui:TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#B7AFE9"
                                Text="{Binding SelectedLayer.TypeLabel}" />

                            <!--  Noise: the colour of the noise  -->
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLayer.Type}" Value="Noise">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <controls:NoiseTypeDropdown VerticalAlignment="Center" Value="{Binding SelectedLayer.NoiseType, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  Field record: the file; a click on its name chooses another one  -->
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLayer.Type}" Value="FieldRecord">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <controls:HintIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static vm:HintTexts.Source}" />
                                <ui:TextBlock
                                    MaxWidth="260"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Foreground="#7FB2FF"
                                    Text="{Binding SelectedLayer.SourceName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="Click to choose another file">
                                    <ui:TextBlock.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.ChangeSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick" />
                                    </ui:TextBlock.InputBindings>
                                    <ui:TextBlock.TextDecorations>
                                        <TextDecoration Location="Underline">
                                            <TextDecoration.Pen>
                                                <Pen Brush="#997FB2FF" Thickness="1">
                                                    <Pen.DashStyle>
                                                        <DashStyle Dashes="1 2" />
                                                    </Pen.DashStyle>
                                                </Pen>
                                            </TextDecoration.Pen>
                                        </TextDecoration>
                                    </ui:TextBlock.TextDecorations>
                                </ui:TextBlock>
                                <!--  Length of the original file; after "|" the whole length with repeats (only when Repeats > 1). Not clickable.  -->
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#A9A7C2"
                                    Text="{Binding SelectedLayer.SourceTimeText}"
                                    ToolTip="Length of the original file" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLayer.Repeats, Converter={StaticResource GreaterThanOne}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#6E6C8A"
                                        Text="|" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Foreground="#A9A7C2"
                                        Text="{Binding SelectedLayer.TotalTimeText}"
                                        ToolTip="Whole length of the layer with repeats and gaps" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <!--  Pitch interval: header (source layer) / body (interval) / footer (Apply)  -->
                        <ui:Button
                            x:Name="IntervalButton"
                            Margin="0,0,90,0"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenIntervalPanelCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Pitch interval: set this layer's pitch relative to another Drone / Pad layer (needs at least two of them)"
                            ToolTipService.ShowOnDisabled="True">
                            <!--  A tuning fork  -->
                            <Path
                                Width="16"
                                Height="16"
                                Data="M5,1 L5,8 A3,3 0 0 0 11,8 L11,1 M8,11 L8,15"
                                Stretch="Uniform"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </ui:Button>
                        <Popup
                            x:Name="IntervalPopup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsIntervalPanelOpen, Mode=TwoWay}"
                            Placement="Custom"
                            PlacementTarget="{Binding ElementName=IntervalButton}"
                            StaysOpen="False">
                            <Border
                                Width="320"
                                Background="#F2181821"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <!--  Header: the layer the pitch is taken from  -->
                                    <StackPanel Margin="14,10,14,12">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#C9C8D6"
                                                Text="Tick a layer to take the pitch from"
                                                ToolTip="One ticked layer: this layer gets an interval above it. Two ticked layers make three together with this one: choose the Root, the other two are set relative to it." />
                                            <ui:Button
                                                Margin="0,-4,-8,0"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Appearance="Transparent"
                                                Command="{Binding CloseIntervalPanelCommand}"
                                                Content="&#10005;"
                                                ToolTip="Close" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding IntervalLayers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox
                                                            Width="22"
                                                            MinWidth="0"
                                                            HorizontalAlignment="Left"
                                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                            IsEnabled="{Binding CanCheck}"
                                                            Template="{StaticResource TickBoxTemplate}"
                                                            Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Text="{Binding Text}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <!--  Root: a small clickable mark; the root layer is outlined  -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            Padding="7,1"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Cursor="Hand"
                                                            ToolTip="The layer that keeps its pitch: the other two are set relative to it">
                                                            <Border.InputBindings>
                                                                <MouseBinding
                                                                    Command="{Binding DataContext.SetIntervalRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    MouseAction="LeftClick" />
                                                            </Border.InputBindings>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Background" Value="#14FFFFFF" />
                                                                    <Setter Property="BorderBrush" Value="#33FFFFFF" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowRoot}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                            <Setter Property="Background" Value="#665B9BFF" />
                                                                            <Setter Property="BorderBrush" Value="#FF5B9BFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock
                                                                Margin="0"
                                                                FontSize="10"
                                                                Foreground="#ECECF2"
                                                                Text="Root" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border Height="1" Background="#2EFFFFFF" />

                                    <!--  One layer ticked: the classic table  -->
                                    <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVisibility}}">
                                        <!--  Body: all intervals at once; [name = link] | [multiplier] | [resulting pitch]  -->
                                        <ItemsControl
                                            Margin="14,8,14,6"
                                            ItemTemplate="{StaticResource IntervalRowTemplate}"
                                            ItemsSource="{Binding IntervalRows}" />
                                        <Border Height="1" Background="#2EFFFFFF" />
                                        <!--  Second group: mathematical ratios, smallest first; open or closed state is remembered in the settings  -->
                                        <Expander
                                            Margin="10,4,10,8"
                                            FontSize="11"
                                            Header="Mathematical ratios"
                                            IsExpanded="{Binding Settings.IntervalMathExpanded, Mode=TwoWay}">
                                            <!--  Tall enough for the whole group; a scroll bar appears only on a very low screen and gets its own margin  -->
                                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl
                                                    Margin="4,2,18,0"
                                                    ItemTemplate="{StaticResource IntervalRowTemplate}"
                                                    ItemsSource="{Binding MathIntervalRows}" />
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>

                                    <!--  Two layers ticked: three layers around the root  -->
                                    <StackPanel Visibility="{Binding IsChordMode, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            Margin="14,8,14,2"
                                            FontSize="10"
                                            Foreground="#8F8DB0"
                                            Text="The root keeps its pitch; the lower and the higher of the other two get the pitches on the right."
                                            TextWrapping="Wrap" />
                                        <ItemsControl
                                            Margin="14,4,14,8"
                                            ItemTemplate="{StaticResource ChordRowTemplate}"
                                            ItemsSource="{Binding ChordRows}" />
                                    </StackPanel>

                                    <!--  Nothing ticked  -->
                                    <TextBlock
                                        Margin="14,8,14,10"
                                        FontSize="11"
                                        Foreground="#8F8DB0"
                                        Text="Tick one layer to take an interval above it, or two layers to tune all three together.">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSingleMode}" Value="False" />
                                                            <Condition Binding="{Binding IsChordMode}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <ui:Button
                            Margin="0,0,60,0"
                            HorizontalAlignment="Right"
                            Command="{Binding RandomizeSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Randomize all sound settings of this layer">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowShuffle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Margin="0,0,30,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Clear: bring the sound settings back to those of a new layer (name, mute, position, length, repeats and file stay)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Margin="0"
                            HorizontalAlignment="Right"
                            Command="{Binding DeleteSelectedLayerCommand}"
                            Style="{StaticResource ToolIconButton}"
                            ToolTip="Remove layer (Del)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <!--  Below this width the parameters scroll horizontally instead of running out of the panel  -->
                    <ScrollViewer
                        x:Name="ParamsScroller"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                    <ContentControl
                        MinWidth="760"
                        Width="{Binding ViewportWidth, ElementName=ParamsScroller}"
                        Content="{Binding SelectedLayer}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="4*" MinWidth="440" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Name / type / mute / placement  -->
                                    <Grid
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            VerticalAlignment="Top"
                                            MaxLength="32"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton
                                            Grid.Column="2"
                                            Margin="14,2,22,0"
                                            VerticalAlignment="Top"
                                            IsChecked="{Binding Muted, Mode=TwoWay}"
                                            Style="{StaticResource MuteToggleButton}">
                                            <ui:SymbolIcon>
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Speaker224" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                <Setter Property="Symbol" Value="SpeakerOff24" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ToggleButton>
                                        <!--  Start and Duration on one line: caption left of the time  -->
                                        <StackPanel
                                            Grid.Column="3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <controls:TimeBox
                                                Margin="0,0,18,0"
                                                Header="Start"
                                                Hint="{x:Static vm:HintTexts.Start}"
                                                IsInline="True"
                                                Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Minimum="0"
                                                Value="{Binding StartSeconds, Mode=TwoWay}" />
                                            <controls:TimeBox
                                                Margin="0,0,0,0"
                                                Header="Duration"
                                                Hint="{x:Static vm:HintTexts.Duration}"
                                                IsInline="True"
                                                Maximum="{Binding DataContext.Project.DurationSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Minimum="2"
                                                Value="{Binding DurationSeconds, Mode=TwoWay}" />
                                            <!--  Repeats: how many plays, the pause between them and the resulting length  -->
                                            <StackPanel Margin="18,0,0,0" Orientation="Horizontal">
                                                <controls:TimeBox
                                                    Margin="0,0,18,0"
                                                    Header="Repeats"
                                                    Hint="{x:Static vm:HintTexts.Repeats}"
                                                    IsInline="True"
                                                    IsInteger="True"
                                                    Maximum="99"
                                                    Minimum="1"
                                                    Value="{Binding Repeats, Mode=TwoWay}" />
                                                <controls:TimeBox
                                                    Margin="0,0,14,0"
                                                    Header="Gap"
                                                    Hint="{x:Static vm:HintTexts.RepeatGap}"
                                                    IsInline="True"
                                                    Maximum="3600"
                                                    Minimum="0"
                                                    Value="{Binding RepeatGapSeconds, Mode=TwoWay}" />

                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!--
                                        All parameters in one wrapping flow (fewer rows at a wide window):
                                        - Level / Brightness / Modulation: one value, or S and E with the curve (double click on the arc)
                                        - Pitch, Pan, Cutoff, Delay: the main knob and its dependent one, always side by side in a group with a link
                                        - Fade in / Fade out: one linked pair, each with its own curve
                                        - Reverb send: one value (Speed / Speed drift live in the Recording group)
                                    -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        HorizontalAlignment="Center">
                                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <controls:KnobPair Margin="12.5,0,12.5,8"><controls:KnobPair.Primary><controls:RangeParam
                                                Easing="{Binding LevelEasing, Mode=TwoWay}"
                                                End="{Binding LevelTo, Mode=TwoWay}"
                                                Format="{}{0:P0}"
                                                Header="Level"
                                                Hint="{x:Static vm:HintTexts.Level}"
                                                Maximum="1"
                                                Minimum="0"
                                                Start="{Binding LevelFrom, Mode=TwoWay}"
                                                Step="0.01" /></controls:KnobPair.Primary></controls:KnobPair>
                                            <controls:KnobPair Margin="12.5,0,12.5,8"><controls:KnobPair.Primary><controls:RangeParam
                                                Easing="{Binding BrightnessEasing, Mode=TwoWay}"
                                                End="{Binding BrightnessTo, Mode=TwoWay}"
                                                Format="{}{0:P0}"
                                                Header="Brightness"
                                                Hint="{x:Static vm:HintTexts.Brightness}"
                                                Maximum="1"
                                                Minimum="0"
                                                Start="{Binding BrightnessFrom, Mode=TwoWay}"
                                                Step="0.01" /></controls:KnobPair.Primary></controls:KnobPair>
                                            <controls:KnobPair Margin="12.5,0,12.5,8"><controls:KnobPair.Primary><controls:RangeParam
                                                Easing="{Binding ModulationEasing, Mode=TwoWay}"
                                                End="{Binding ModulationTo, Mode=TwoWay}"
                                                Format="{}{0:P0}"
                                                Header="Modulation"
                                                Hint="{x:Static vm:HintTexts.Modulation}"
                                                Maximum="1"
                                                Minimum="0"
                                                Start="{Binding ModulationFrom, Mode=TwoWay}"
                                                Step="0.01" /></controls:KnobPair.Primary></controls:KnobPair>
                                            <controls:KnobPair Margin="12.5,0,12.5,8"><controls:KnobPair.Primary><controls:LabeledSlider
                                                Format="{}{0:P0}"
                                                Header="Reverb send"
                                                Hint="{x:Static vm:HintTexts.ReverbSend}"
                                                Maximum="1"
                                                Minimum="0"
                                                Step="0.01"
                                                Value="{Binding ReverbSend, Mode=TwoWay}" /></controls:KnobPair.Primary></controls:KnobPair>
                                            <controls:KnobPair Margin="12.5,0,12.5,8" LinkToolTip="Fade in and fade out">
                                                <controls:KnobPair.Primary><controls:RangeParam
                                                    AllowRange="False"
                                                    Easing="{Binding FadeEasing, Mode=TwoWay}"
                                                    Format="{}{0:0} s"
                                                    Header="Fade in"
                                                    Hint="{x:Static vm:HintTexts.FadeIn}"
                                                    Maximum="{Binding DurationSeconds}"
                                                    Minimum="0"
                                                    Start="{Binding FadeInSeconds, Mode=TwoWay}"
                                                    Step="1" /></controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary><controls:RangeParam
                                                    AllowRange="False"
                                                    Easing="{Binding FadeOutEasing, Mode=TwoWay}"
                                                    Format="{}{0:0} s"
                                                    Header="Fade out"
                                                    Hint="{x:Static vm:HintTexts.FadeOut}"
                                                    Maximum="{Binding DurationSeconds}"
                                                    Minimum="0"
                                                    Start="{Binding FadeOutSeconds, Mode=TwoWay}"
                                                    Step="1" /></controls:KnobPair.Secondary>
                                            </controls:KnobPair>
                                        </WrapPanel>
                                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <controls:KnobPair
                                                Margin="12.5,0,12.5,8"
                                                LinkToolTip="Pitch drift">
                                                <controls:KnobPair.Style>
                                                    <Style TargetType="controls:KnobPair">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Noise">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="FieldRecord">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:KnobPair.Style>
                                                <controls:KnobPair.Primary>
                                                    <controls:LabeledSlider
                                                        Format="{}{0:0.0} Hz"
                                                        Header="Pitch"
                                                        Hint="{x:Static vm:HintTexts.Pitch}"
                                                        IsLogarithmic="True"
                                                        Maximum="1000"
                                                        Minimum="20"
                                                        Step="0.1"
                                                        Value="{Binding PitchHz, Mode=TwoWay}" />
                                                </controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary>
                                                    <Border>
                                                        <controls:LabeledSlider
                                                            Format="{}{0:P0}"
                                                            Header="Pitch drift"
                                                            Hint="{x:Static vm:HintTexts.PitchDrift}"
                                                            Maximum="1"
                                                            Minimum="0"
                                                            Step="0.01"
                                                            Value="{Binding PitchDrift, Mode=TwoWay}" />
                                                    </Border>
                                                </controls:KnobPair.Secondary>
                                            </controls:KnobPair>
                                            <controls:KnobPair
                                                Margin="12.5,0,12.5,8"
                                                LinkToolTip="Pan drift">
                                                <controls:KnobPair.Style>
                                                    <Style TargetType="controls:KnobPair">
                                                        <Style.Triggers />
                                                    </Style>
                                                </controls:KnobPair.Style>
                                                <controls:KnobPair.Primary>
                                                    <controls:LabeledSlider
                                                        Format="{}{0:+0.00;-0.00;0.00}"
                                                        Header="Pan"
                                                        Hint="{x:Static vm:HintTexts.Pan}"
                                                        Maximum="1"
                                                        Minimum="-1"
                                                        Step="0.05"
                                                        Value="{Binding Pan, Mode=TwoWay}" />
                                                </controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary>
                                                    <Border>
                                                        <controls:LabeledSlider
                                                            Format="{}{0:P0}"
                                                            Header="Pan drift"
                                                            Hint="{x:Static vm:HintTexts.PanDrift}"
                                                            Maximum="1"
                                                            Minimum="0"
                                                            Step="0.01"
                                                            Value="{Binding PanDrift, Mode=TwoWay}" />
                                                    </Border>
                                                </controls:KnobPair.Secondary>
                                            </controls:KnobPair>
                                            <controls:KnobPair
                                                Margin="12.5,0,12.5,8"
                                                LinkToolTip="Resonance">
                                                <controls:KnobPair.Style>
                                                    <Style TargetType="controls:KnobPair">
                                                        <Style.Triggers />
                                                    </Style>
                                                </controls:KnobPair.Style>
                                                <controls:KnobPair.Primary>
                                                    <controls:LabeledSlider
                                                        Format="{}{0:0} Hz"
                                                        Header="Cutoff"
                                                        Hint="{x:Static vm:HintTexts.Cutoff}"
                                                        IsLogarithmic="True"
                                                        Maximum="20000"
                                                        Minimum="20"
                                                        Step="1"
                                                        Value="{Binding FilterCutoffHz, Mode=TwoWay}" />
                                                </controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary>
                                                    <Border>
                                                        <controls:LabeledSlider
                                                            Format="{}{0:P0}"
                                                            Header="Resonance"
                                                            Hint="{x:Static vm:HintTexts.Resonance}"
                                                            Maximum="1"
                                                            Minimum="0"
                                                            Step="0.01"
                                                            Value="{Binding FilterResonance, Mode=TwoWay}" />
                                                    </Border>
                                                </controls:KnobPair.Secondary>
                                            </controls:KnobPair>
                                            <controls:KnobPair
                                                Margin="12.5,0,12.5,8"
                                                LinkToolTip="Feedback">
                                                <controls:KnobPair.Style>
                                                    <Style TargetType="controls:KnobPair">
                                                        <Style.Triggers />
                                                    </Style>
                                                </controls:KnobPair.Style>
                                                <controls:KnobPair.Primary>
                                                    <controls:LabeledSlider
                                                        Format="{}{0:0.00} s"
                                                        Header="Delay"
                                                        Hint="{x:Static vm:HintTexts.Delay}"
                                                        Maximum="2"
                                                        Minimum="0"
                                                        Step="0.01"
                                                        Value="{Binding DelaySeconds, Mode=TwoWay}" />
                                                </controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary>
                                                    <Border>
                                                        <controls:LabeledSlider
                                                            Format="{}{0:P0}"
                                                            Header="Feedback"
                                                            Hint="{x:Static vm:HintTexts.Feedback}"
                                                            Maximum="0.92"
                                                            Minimum="0"
                                                            Step="0.01"
                                                            Value="{Binding DelayFeedback, Mode=TwoWay}" />
                                                    </Border>
                                                </controls:KnobPair.Secondary>
                                            </controls:KnobPair>
                                        </WrapPanel>

                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Border>
</UserControl>
