<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.RecordingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Recording group (Field record layers only): reverse, stretch, pitch, loop  -->
            <Border
                Margin="0,0,6,0"
                DataContext="{Binding SelectedLayer}"
                >
                <Border.Style>
                    <Style BasedOn="{StaticResource SectionCard}" TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="FieldRecord">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Width="380">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Recording" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#E6D25A"
                            Text="processing..."
                            Visibility="{Binding DataContext.IsSelectedSourceProcessing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!--  3 rows of controls, 2 columns; the piece of the file that is played and looped  -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:ToggleSwitch Content="Reverse" IsChecked="{Binding Reverse, Mode=TwoWay}" />
                            <controls:HintIcon Margin="5,0,0,0" Text="{x:Static vm:HintTexts.Reverse}" />
                        </StackPanel>

                        <controls:LabeledSlider
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            Format="{}{0:0.0}x"
                            Header="Stretch"
                            Hint="{x:Static vm:HintTexts.Stretch}"
                            IsLogarithmic="True"
                            Maximum="50"
                            Minimum="1"
                            Step="0.1"
                            Value="{Binding Stretch, Mode=TwoWay}" />
                        <controls:LabeledSlider
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Format="{}{0:+0.0;-0.0;0} st"
                            Header="Pitch shift"
                            Hint="{x:Static vm:HintTexts.PitchShift}"
                            Maximum="24"
                            Minimum="-24"
                            Step="0.5"
                            Value="{Binding PitchShift, Mode=TwoWay}" />

                        <controls:KnobPair Icon="Speed"
                                                Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                LinkToolTip="Speed drift">
                                                <controls:KnobPair.Primary>
                                                    <controls:LabeledSlider
                                                        Format="{}{0:0.00}x"
                                                        Header="Speed"
                                                        Hint="{x:Static vm:HintTexts.Speed}"
                                                        IsLogarithmic="True"
                                                        Maximum="4"
                                                        Minimum="0.25"
                                                        Step="0.01"
                                                        Value="{Binding Speed, Mode=TwoWay}" />
                                                </controls:KnobPair.Primary>
                                                <controls:KnobPair.Secondary>
                                                    <Border>
                                                        <controls:LabeledSlider
                                                            Format="{}{0:P0}"
                                                            Header="Speed drift"
                                                            Hint="{x:Static vm:HintTexts.PitchDrift}"
                                                            Maximum="1"
                                                            Minimum="0"
                                                            Step="0.01"
                                                            Value="{Binding PitchDrift, Mode=TwoWay}" />
                                                    </Border>
                                                </controls:KnobPair.Secondary>
                                            </controls:KnobPair>

                        <!--  Scissors on: the whole file without repeats or stretch; drag on it to mark the loop piece  -->
<StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
    <StackPanel.Style>
        <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoopCutMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Style>
    <Border
        Height="64"
        Background="#14FFFFFF"
        BorderBrush="#408F8DB0"
        BorderThickness="1"
        CornerRadius="5">
        <controls:RangeWaveform
            Margin="2"
            Duration="{Binding SelectedSourceSeconds}"
            Peaks="{Binding SourcePeaks}"
            RangeEnd="{Binding LoopCutEnd, Mode=TwoWay}"
            RangeStart="{Binding LoopCutStart, Mode=TwoWay}" />
    </Border>
    <TextBlock
        Margin="0,4,0,0"
        HorizontalAlignment="Center"
        FontSize="11"
        Foreground="#E6D25A"
        Text="{Binding LoopCutText}" />
</StackPanel>

                        <controls:LabeledSlider
                            Grid.Row="4"
                            Grid.RowSpan="2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Format="{}{0:0.0} s"
                            Header="Loop crossfade"
                            Hint="{x:Static vm:HintTexts.LoopCrossfade}"
                            Maximum="10"
                            Minimum="0"
                            Step="0.1"
                            Value="{Binding LoopCrossfade, Mode=TwoWay}" />
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="6,6,0,0"
                            Orientation="Horizontal">
                            <controls:TimeBox
                                Header="Loop start"
                                Hint="{x:Static vm:HintTexts.LoopStart}"
                                Maximum="{Binding DataContext.SelectedSourceSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                Minimum="0"
                                Value="{Binding LoopStart, Mode=TwoWay}" />
                            <!--  Scissors: mark a piece on the layer in the timeline; a second click puts it into Loop start and duration  -->
                            <ToggleButton
                                Width="30"
                                Height="30"
                                Margin="8,0,0,0"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                Command="{Binding DataContext.ToggleLoopCutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Cursor="Hand"
                                IsChecked="{Binding DataContext.IsLoopCutMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                ToolTip="Scissors: click to show the whole recording, mark the piece to loop on it with the mouse, then click again to take it as Loop start and Loop duration">
                                <ui:SymbolIcon FontSize="16" Symbol="Cut24" />
                            </ToggleButton>
                        </StackPanel>
                        <controls:TimeBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="6,6,0,0"
                            Header="Loop duration"
                            Hint="{x:Static vm:HintTexts.LoopDuration}"
                            Maximum="{Binding DataContext.SelectedSourceSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                            Minimum="0.5"
                            Value="{Binding LoopDuration, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#8F8DB0"
                        Text="{Binding DataContext.SelectedPieceText, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                </Border>
</UserControl>
