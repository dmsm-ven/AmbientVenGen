<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.StartScreenPanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--  Shown instead of the editor until a project is opened: the recent projects as big tiles, the newest first  -->
    <UserControl.Resources>
        <Style x:Key="ProjectTile" TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#ECECF2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Frame"
                            Background="#14FFFFFF"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#5B9BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#335B9BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:TextBlock
                Margin="0,24,0,12"
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#C9C8D6"
                Text="Recent projects" />
            <ItemsControl ItemsSource="{Binding RecentTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.OpenRecentCommand, ElementName=Root}"
                            CommandParameter="{Binding Path}"
                            Style="{StaticResource ProjectTile}"
                            ToolTip="{Binding Path}">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon
                                    HorizontalAlignment="Left"
                                    FontSize="30"
                                    Foreground="#9CC2FF"
                                    Symbol="Document24" />
                                <TextBlock
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    MaxHeight="48" />
                                <TextBlock
                                    Grid.Row="2"
                                    FontSize="12"
                                    Foreground="#B7AFE9"
                                    Text="{Binding DateText}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="#80C9C8D6"
                                    Text="{Binding Folder}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
