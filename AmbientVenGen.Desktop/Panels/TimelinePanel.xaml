<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.TimelinePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Timeline: transport buttons and the track  -->
        <Border
            Margin="10,0,10,8"
            Padding="0"
            Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  One compact line: title, transport buttons, reverb and track length  -->
                <Grid Grid.Row="0" Margin="12,3,12,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Command="{Binding TogglePlayCommand}" Style="{StaticResource PlayStopButton}" />
                        <ui:Button
                            Command="{Binding RegenerateCommand}"
                            Style="{StaticResource TimelineIconButton}"
                            ToolTip="Regenerate (new seed)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding ToggleSpectrogramCommand}" Style="{StaticResource SpectrogramButton}" />
                    </StackPanel>

                    <!--  Space (reverb): horizontal  -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Space (reverb)" />
                        <controls:HintIcon Margin="5,0,8,0" Text="{x:Static vm:HintTexts.Reverb}" />
                        <Slider
                            Width="130"
                            VerticalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding Project.ReverbMix, Mode=TwoWay}" />
                        <ui:TextBlock
                            Width="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#B7AFE9"
                            Text="{Binding Project.ReverbMix, StringFormat={}{0:P0}}" />
                    </StackPanel>

                    <!--  Track length: horizontal  -->
                    <StackPanel
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Track length" />
                        <controls:HintIcon Margin="5,0,8,0" Text="{x:Static vm:HintTexts.TrackLength}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding LengthOptions}"
                            SelectedValue="{Binding Project.DurationSeconds, Mode=TwoWay}"
                            Style="{StaticResource ChoiceCombo}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <controls:TimelineControl
                        x:Name="Timeline"
                        DeleteCommand="{Binding DeleteSelectedLayerCommand}"
                        NewLayerType="{Binding NewLayer.Type, Mode=OneWay}"
                        PlayheadSeconds="{Binding PlayheadSeconds}"
                        Project="{Binding Project}"
                        SeekCommand="{Binding SeekCommand}"
                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}"
                        ShowSpectrogram="{Binding ShowSpectrogram}"
                        SpectrogramColor="{Binding Settings.SpectrogramColor}"
                        Spectrograms="{Binding Spectrograms}" />
                </ScrollViewer>
            </Grid>
        </Border>
</UserControl>
