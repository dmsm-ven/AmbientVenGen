<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.TimelinePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Timeline: transport buttons and the track  -->
        <Border
            Margin="10,0,10,8"
            Padding="0"
            Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  One compact line: title, transport buttons, reverb and track length  -->
                <Grid Grid.Row="0" Margin="12,3,12,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Timeline" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Command="{Binding TogglePlayCommand}" Style="{StaticResource PlayStopButton}" />
                        <ui:Button
                            Command="{Binding RegenerateCommand}"
                            Style="{StaticResource TimelineIconButton}"
                            ToolTip="Regenerate (new seed)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding ToggleSpectrogramCommand}" Style="{StaticResource SpectrogramButton}" />
                    </StackPanel>

                    <!--  Space (reverb): shown when its button on the right is pressed  -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsChecked, ElementName=ReverbToggle, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Space (reverb)" />
                        <controls:HintIcon Margin="0,0,10,0" Text="{x:Static vm:HintTexts.Reverb}" />
                        <Slider
                            Width="110"
                            VerticalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding Project.ReverbMix, Mode=TwoWay}" />
                        <ui:TextBlock
                            Width="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#B7AFE9"
                            Text="{Binding Project.ReverbMix, StringFormat={}{0:P0}}" />
                    </StackPanel>

                    <!--  Shimmer: the reverb tail shifted up and fed back; the interval is right of the slider  -->
                    <StackPanel
                        Grid.Column="4"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsChecked, ElementName=ShimmerToggle, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Shimmer" />
                        <controls:HintIcon Margin="0,0,10,0" Text="{x:Static vm:HintTexts.Shimmer}" />
                        <Slider
                            Width="110"
                            VerticalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding Project.Shimmer, Mode=TwoWay}" />
                        <ui:TextBlock
                            Width="36"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#B7AFE9"
                            Text="{Binding Project.Shimmer, StringFormat={}{0:P0}}" />
                        <Slider
                            Width="90"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="24"
                            Minimum="-24"
                            SmallChange="1"
                            TickFrequency="1"
                            ToolTip="Shimmer interval in semitones (+12 = an octave up)"
                            Value="{Binding Project.ShimmerSemitones, Mode=TwoWay}" />
                        <ui:TextBlock
                            Width="46"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#B7AFE9"
                            Text="{Binding Project.ShimmerSemitones, StringFormat={}{0:+0;-0;0} st}" />
                    </StackPanel>

                    <!--  Track length: horizontal  -->
                    <StackPanel
                        Grid.Column="5"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#C9C8D6"
                            Text="Track length" />
                        <controls:HintIcon Margin="0,0,10,0" Text="{x:Static vm:HintTexts.TrackLength}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding LengthOptions}"
                            SelectedValue="{Binding Project.DurationSeconds, Mode=TwoWay}"
                            Style="{StaticResource ChoiceCombo}" />
                    </StackPanel>

                    <!--  The two small buttons: they open the Space (reverb) and Shimmer sliders  -->
                    <StackPanel
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="ReverbToggle"
                            Style="{StaticResource ToolIconToggleButton}"
                            ToolTip="Space (reverb)">
                            <ui:SymbolIcon Symbol="DataArea24" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ShimmerToggle"
                            Margin="0"
                            Style="{StaticResource ToolIconToggleButton}"
                            ToolTip="Shimmer">
                            <ui:SymbolIcon Symbol="Sparkle24" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <controls:TimelineControl
                        x:Name="Timeline"
                        CutEnd="{Binding LoopCutEnd, Mode=TwoWay}"
                        CutStart="{Binding LoopCutStart, Mode=TwoWay}"
                        DeleteCommand="{Binding DeleteSelectedLayerCommand}"
                        IsCutMode="{Binding IsLoopCutMode}"
                        NewLayerType="{Binding NewLayer.Type, Mode=OneWay}"
                        PlayheadSeconds="{Binding PlayheadSeconds}"
                        Project="{Binding Project}"
                        IsSoloActive="{Binding IsSoloActive}"
                        SeekCommand="{Binding SeekCommand}"
                        SoloCommand="{Binding ToggleSoloCommand}"
                        SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}"
                        ShowSpectrogram="{Binding ShowSpectrogram}"
                        SpectrogramColor="{Binding Settings.SpectrogramColor}"
                        Spectrograms="{Binding Spectrograms}" />
                </ScrollViewer>

                <!--  The second ruler: always visible, even when the layers scroll  -->
                <controls:TimelineRuler
                    Grid.Row="2"
                    Width="{Binding ActualWidth, ElementName=Timeline}"
                    HorizontalAlignment="Left"
                    Timeline="{Binding ElementName=Timeline}" />
            </Grid>
        </Border>
</UserControl>
