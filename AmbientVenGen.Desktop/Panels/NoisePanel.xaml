<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.NoisePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Noise layers only: every noise type as a coloured tile, the same choice as the Noise Type combobox  -->
    <Border Margin="0,0,6,0" DataContext="{Binding SelectedLayer}">
        <Border.Style>
            <Style BasedOn="{StaticResource SectionCard}" TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Noise">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,6"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Noise type" />

            <ListBox
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="420"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{x:Static vm:Choices.NoiseOptions}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedValue="{Binding NoiseType, Mode=TwoWay}"
                SelectedValuePath="Value">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Height" Value="27" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="ToolTip" Value="{Binding Likeness}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!--  The same colour fill as in the combobox, the name on top of it  -->
                                        <controls:NoiseColorIcon Noise="{Binding Value}" />
                                        <Border
                                            x:Name="Mark"
                                            BorderBrush="#F2F2F8"
                                            BorderThickness="0"
                                            CornerRadius="4" />
                                        <Border
                                            x:Name="Hover"
                                            Background="#22FFFFFF"
                                            CornerRadius="4"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            Margin="4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFFF"
                                            Text="{Binding Label}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="4"
                                                    Opacity="0.95"
                                                    ShadowDepth="0"
                                                    Color="#000000" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Mark" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
