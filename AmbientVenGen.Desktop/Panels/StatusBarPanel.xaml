<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.StatusBarPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  Status line + progress of export and of the processing of recordings  -->
        <Border
            Margin="0,10,0,0"
            Padding="16,6"
            BorderBrush="#2EFFFFFF"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    Foreground="#AAA9BB"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <!--  Recordings are being stretched / transposed (e.g. after opening a project)  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsRebuilding, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Foreground="#E6D25A"
                        Text="{Binding RebuildText}" />
                    <ProgressBar
                        Width="200"
                        Height="6"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding RebuildProgress, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        Width="200"
                        Height="6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding ExportProgress, Mode=OneWay}" />
                    <ui:Button
                        Margin="0"
                        Command="{Binding CancelExportCommand}"
                        Style="{StaticResource ToolIconButton}"
                        ToolTip="Cancel export">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
