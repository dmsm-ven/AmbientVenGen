<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.ModulatorsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  The modulators of the selected layer: any number, added with the "+" button below the last one  -->
    <Border
        Margin="6,0,0,0"
        IsEnabled="{Binding HasSelectedLayer}"
        Style="{StaticResource SectionCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBlock
                Margin="0,0,0,4"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Modulators" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SelectedLayer.Modulators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ModulatorEditor Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnAddModulatorClick"
                        ToolTip="Add a modulator">
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
