<UserControl
    x:Class="AmbientVenGen.Desktop.Panels.ModulatorsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AmbientVenGen.Desktop.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AmbientVenGen.Desktop.ViewModels">
    <!--  The two modulators of the selected layer  -->
            <Border
                Margin="10,0,0,0"
                IsEnabled="{Binding HasSelectedLayer}"
                Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ui:TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Modulators" />
                    <controls:ModulatorEditor
                    Margin="0,0,0,8"
                    DataContext="{Binding SelectedLayer.Mod1}"
                    Header="Modulator 1" />
                    <controls:ModulatorEditor
                    DataContext="{Binding SelectedLayer.Mod2}"
                    Header="Modulator 2" />
                </StackPanel>
            </Border>
</UserControl>
