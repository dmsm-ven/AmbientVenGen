<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The audio engine and the composition model: no WPF, no UI, no dialogs.
    Windows-only parts (WaveOut playback, MP3 through Media Foundation) stay in AmbientVenGen.Desktop.
    NAudio is the same package as in Desktop. It can be narrowed to NAudio.Core (and the target to
    plain net10.0) when the engine has to run outside Windows, e.g. in tests on a Linux build agent.
  -->
  <PropertyGroup>
    <RootNamespace>AmbientVenGen.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
